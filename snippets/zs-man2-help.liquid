    <table class="m2-legend"><thead><tr><th>No.</th><th>Name</th><th>What it does</th></tr></thead><tbody>
      <tr><td><span class="m2-letter m2-letter--num">1</span></td><td><b>Copy diagnostics</b></td><td>Copies versions, config and log to paste into a message to us.</td></tr>
    </tbody></table>
    <figure class="m2-fig">
