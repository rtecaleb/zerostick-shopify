{%- comment -%}
  BreadcrumbList structured data. Gives Google a readable path in place of a
  raw URL, and gives AI search a plain-language sense of where a page sits in
  the catalogue. Uses the collection the visitor actually arrived through when
  there is one, otherwise falls back to the product's first collection.
{%- endcomment -%}

{%- liquid
  assign crumb_collection = collection
  if crumb_collection == blank and product.collections.size > 0
    assign crumb_collection = product.collections.first
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ request.origin | append: routes.root_url | json }}
    }{%- if crumb_collection != blank -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ crumb_collection.title | json }},
      "item": {{ crumb_collection.url | prepend: request.origin | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ product.url | prepend: request.origin | json }}
    }
    {%- else -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ product.url | prepend: request.origin | json }}
    }
    {%- endif -%}
  ]
}
</script>
