{% schema %}
{
  "name": "EXO pre-order",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Line under the title",
      "default": "Mouse & keyboard or any controller, on PS5, Xbox and PC. Set up from your phone." },
    { "type": "text", "id": "ship_date", "label": "Ship date (long)", "default": "January 1, 2027" },
    { "type": "text", "id": "ship_short", "label": "Ship date (short, on the button)", "default": "Jan 1, 2027" },
    { "type": "text", "id": "discord_url", "label": "Discord invite link", "info": "PLACEHOLDER until the real invite link is known.", "default": "https://discord.gg/qXTrrMYanb" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "caleb@zerostickgaming.com" },
    { "type": "text", "id": "landing_url", "label": "EXO overview page link", "default": "/pages/zerostick-exo" },
    { "type": "text", "id": "games_url", "label": "Supported games page link", "default": "/pages/supported-games" },
    { "type": "checkbox", "id": "show_fcc_notice", "label": "Show FCC pre-authorization notice", "info": "Off by default. Confirm the exact wording with your test lab / TCB before switching on.", "default": false }
  ]
}
{% endschema %}
