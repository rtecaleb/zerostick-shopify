{"variants":[{%- for v in product.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"available":{{ v.available | json }},"price":{{ v.price | money | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
 "shipShort":{{ section.settings.ship_short | json }}}
</script>
<script src="{{ 'zs-exo2.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'zs-exo-preorder.js' | asset_url }}" defer="defer"></script>

