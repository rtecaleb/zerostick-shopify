<script>
  (function(){
    var slides=document.querySelectorAll('.hero-slide'), dots=document.querySelectorAll('.hero-dot'), cur=0;
    function go(n){ if(!slides.length) return; slides[cur].classList.remove('active'); dots[cur].classList.remove('active'); cur=n; slides[cur].classList.add('active'); dots[cur].classList.add('active'); }
    dots.forEach(function(d){ d.addEventListener('click', function(){ go(+d.dataset.i); }); });
    if(slides.length) setInterval(function(){ go((cur+1)%slides.length); }, 5000);

    /* Swipe the hero banner left/right on touch screens */
    var hs=document.querySelector('.hero-slider'), tx=null;
    if(hs){
      hs.addEventListener('touchstart', function(e){ tx=e.touches[0].clientX; }, {passive:true});
      hs.addEventListener('touchend', function(e){
        if(tx===null) return;
        var dx=e.changedTouches[0].clientX - tx; tx=null;
        if(Math.abs(dx)<40) return;                       /* ignore tiny moves */
        go(dx<0 ? (cur+1)%slides.length : (cur-1+slides.length)%slides.length);
      }, {passive:true});
    }

    /* Mobile reviews: arrows scroll one card at a time (swipe works natively) */
    var track=document.getElementById('mRevTrack');
    document.querySelectorAll('.m-rev-arrow').forEach(function(b){
      b.addEventListener('click', function(){
        if(track) track.scrollBy({left: (+b.dataset.dir)*(track.clientWidth*0.85), behavior:'smooth'});
      });
    });

    document.querySelectorAll('.feature-tab').forEach(function(t){
      t.addEventListener('click', function(){
        document.querySelectorAll('.feature-panel').forEach(function(p){ p.classList.remove('active'); });
        document.querySelectorAll('.feature-tab').forEach(function(x){ x.classList.remove('active'); });
        document.getElementById(t.dataset.tab).classList.add('active');
        t.classList.add('active');
      });
    });

    var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold:0.1 });
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  })();
</script>

