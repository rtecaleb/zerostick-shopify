{% comment %}
  ZeroStick EXO — device advertisement page (the "Overview" sub-tab).

  Self-contained: styles scoped under .zx-exo, colours from theme tokens.
  The product image is an inline SVG prototype render (labelled as such —
  there is no photographable hardware yet). The "GPC Scripts" sub-tab link
  is guarded on the pages['zerostick-exo-scripts'] object, same pattern as
  the header tab, so it cannot dead-end before that page exists in admin.
{% endcomment %}

<style>
  .zx-exo{ line-height:1.6; }
  .zx-exo .zx-tabs{ display:flex; gap:.4rem; margin:0 0 2.8rem;
    border-bottom:.1rem solid rgba(var(--color-foreground),.14); }
  .zx-exo .zx-tabs a, .zx-exo .zx-tabs span{ display:inline-block; padding:.9rem 1.6rem;
    font-size:1.4rem; font-weight:600; text-decoration:none;
    color:rgba(var(--color-foreground),.65); border-bottom:.25rem solid transparent; }
  .zx-exo .zx-tabs .on{ color:rgb(var(--color-foreground));
    border-bottom-color:rgb(var(--color-foreground)); }
  .zx-exo .zx-eyebrow{ font-size:1.2rem; font-weight:600; letter-spacing:.14em;
    text-transform:uppercase; opacity:.75; margin:0 0 1rem; }
  .zx-exo h1{ margin:0 0 1rem; }
  .zx-exo h2{ margin:4.4rem 0 1rem; }
  .zx-exo h3{ margin:0 0 .6rem; }
  .zx-exo .zx-lede{ font-size:1.8rem; opacity:.8; margin:0 0 2rem; }
  .zx-exo .zx-know{ border:.1rem solid rgba(var(--color-foreground),.18);
    border-left:.4rem solid #58a6ff; border-radius:.8rem; padding:1.2rem 1.6rem;
    font-size:1.5rem; margin:0 0 2rem; }
  .zx-exo .zx-hero{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    gap:3.2rem; align-items:center; }
  @media (max-width:820px){ .zx-exo .zx-hero{ grid-template-columns:1fr; } }
  .zx-exo .zx-render{ width:100%; height:auto; display:block; }
  .zx-exo .zx-render-cap{ font-size:1.2rem; opacity:.6; text-align:center; margin-top:.6rem; }
  .zx-exo .zx-cards{ display:grid; grid-template-columns:repeat(auto-fit,minmax(24rem,1fr));
    gap:1.4rem; margin:2rem 0; }
  .zx-exo .zx-card{ border:.1rem solid rgba(var(--color-foreground),.12);
    border-radius:1.2rem; padding:1.8rem 2rem; }
  .zx-exo .zx-card p{ margin:0; opacity:.75; font-size:1.4rem; }
  .zx-exo .zx-vision{ border:.1rem solid rgba(var(--color-foreground),.14);
    border-radius:1.4rem; padding:2.4rem 2.6rem; margin:2.4rem 0; }
  .zx-exo .zx-vision p:last-child{ margin-bottom:0; }
  .zx-exo .zx-fine{ font-size:1.3rem; opacity:.65; margin-top:4rem;
    border-top:.1rem solid rgba(var(--color-foreground),.12); padding-top:1.6rem; }
  .zx-exo .zx-cta-row{ display:flex; flex-wrap:wrap; gap:1.2rem; margin:2rem 0 1rem; }
</style>

<div class="page-width zx-exo" style="padding-top:3.2rem;padding-bottom:5.6rem;">

  <nav class="zx-tabs" aria-label="ZeroStick EXO pages">
    <span class="on" aria-current="page">Overview</span>
    {%- assign zx_scripts = pages['zerostick-exo-scripts'] -%}
    {%- if zx_scripts != empty and zx_scripts.url != blank -%}
      <a href="{{ zx_scripts.url }}">GPC Scripts</a>
    {%- endif -%}
  </nav>

  <div class="zx-hero">
    <div>
      <p class="zx-eyebrow">Coming soon</p>
      <h1>ZeroStick EXO</h1>
      <p class="zx-lede">The adapter that brings <strong>AI to console
      players</strong>. Any controller — or mouse &amp; keyboard — on your
      console, your scripts running on-device, and computer-vision aim help
      that steadies your last few degrees. All of it set up from your phone.</p>
      <div class="zx-know">Know the <strong>Cronus Zen</strong> or the
      <strong>XIM</strong>? That's the category — an adapter between your
      controller and your console. The EXO is that class of device,
      <strong>rebuilt for 2026 with AI built in</strong>: it runs your GPC
      scripts <em>and</em> watches the game to help you aim.</div>
      <div class="zx-cta-row">
        {%- if zx_scripts != empty and zx_scripts.url != blank -%}
          <a href="{{ zx_scripts.url }}" class="button">See how scripts work</a>
        {%- endif -%}
        {%- if section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="button button--secondary">
            {{ section.settings.cta_label | default: 'Get launch updates' | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
    <div>
      <svg class="zx-render" viewBox="0 0 640 480" role="img"
           aria-label="Prototype render of the ZeroStick EXO: a slim dark adapter box with controller ports, a console port, and an HDMI input for Screen Assist">
        <defs>
          <linearGradient id="zxTop" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#262c36"/>
            <stop offset="1" stop-color="#14181f"/>
          </linearGradient>
          <linearGradient id="zxFace" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#10141a"/>
            <stop offset="1" stop-color="#080a0e"/>
          </linearGradient>
          <linearGradient id="zxGlow" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#58a6ff" stop-opacity="0"/>
            <stop offset=".5" stop-color="#58a6ff"/>
            <stop offset="1" stop-color="#58a6ff" stop-opacity="0"/>
          </linearGradient>
          <radialGradient id="zxHalo" cx=".5" cy=".45" r=".6">
            <stop offset="0" stop-color="#58a6ff" stop-opacity=".22"/>
            <stop offset="1" stop-color="#58a6ff" stop-opacity="0"/>
          </radialGradient>
        </defs>

        <rect x="0" y="0" width="640" height="480" fill="none"/>
        <ellipse cx="320" cy="250" rx="300" ry="180" fill="url(#zxHalo)"/>

        <!-- body: slim wedge, top face + front face -->
        <g>
          <ellipse cx="320" cy="392" rx="238" ry="26" fill="#000" opacity=".45"/>
          <path d="M96 236 L544 236 L560 340 Q560 356 544 356 L96 356 Q80 356 80 340 Z"
                fill="url(#zxFace)" stroke="#30363d" stroke-width="1.5"/>
          <path d="M128 156 Q128 148 136 148 L504 148 Q512 148 512 156 L544 236 L96 236 Z"
                fill="url(#zxTop)" stroke="#3a414b" stroke-width="1.5"/>
          <!-- top face: wordmark + status LED -->
          <text x="320" y="204" text-anchor="middle" fill="#e6edf3"
                font-family="Arial, sans-serif" font-size="26" font-weight="700"
                letter-spacing="6">ZEROSTICK</text>
          <text x="320" y="226" text-anchor="middle" fill="#8b949e"
                font-family="Arial, sans-serif" font-size="13" letter-spacing="8">E X O</text>
          <circle cx="497" cy="171" r="4.5" fill="#3fb950"/>
          <circle cx="497" cy="171" r="9" fill="#3fb950" opacity=".22"/>
          <!-- light strip along the front edge -->
          <rect x="112" y="238" width="416" height="3.5" rx="1.75" fill="url(#zxGlow)" opacity=".9"/>

          <!-- front ports -->
          <g font-family="Arial, sans-serif" font-size="10.5" fill="#8b949e" text-anchor="middle">
            <rect x="140" y="278" width="52" height="24" rx="4" fill="#05070a" stroke="#3a414b"/>
            <rect x="150" y="286" width="32" height="8" rx="2" fill="#161b22" stroke="#30363d" stroke-width=".8"/>
            <text x="166" y="322">PAD 1</text>

            <rect x="216" y="278" width="52" height="24" rx="4" fill="#05070a" stroke="#3a414b"/>
            <rect x="226" y="286" width="32" height="8" rx="2" fill="#161b22" stroke="#30363d" stroke-width=".8"/>
            <text x="242" y="322">PAD 2</text>

            <rect x="300" y="282" width="44" height="16" rx="8" fill="#05070a" stroke="#58a6ff" stroke-width="1.2"/>
            <text x="322" y="322" fill="#58a6ff">CONSOLE</text>

            <rect x="380" y="278" width="70" height="24" rx="4" fill="#05070a" stroke="#3a414b"/>
            <path d="M388 284 L442 284 L436 296 L394 296 Z" fill="#161b22" stroke="#30363d" stroke-width=".8"/>
            <text x="415" y="322">HDMI IN</text>

            <circle cx="490" cy="290" r="9" fill="#05070a" stroke="#3a414b"/>
            <circle cx="490" cy="290" r="3" fill="#161b22"/>
            <text x="490" y="322">PAIR</text>
          </g>
        </g>

        <!-- labels -->
        <g font-family="Arial, sans-serif" font-size="12" fill="#8b949e">
          <text x="96" y="120">Your controllers plug in here</text>
          <path d="M150 128 L160 146" stroke="#4a5361" stroke-width="1"/>
          <text x="392" y="120">The game's picture, for Screen Assist</text>
          <path d="M452 128 L432 146" stroke="#4a5361" stroke-width="1"/>
          <text x="286" y="404" fill="#58a6ff">One cable to the console</text>
          <path d="M322 384 L322 366" stroke="#58a6ff" stroke-width="1" opacity=".6"/>
        </g>

        <!-- prototype tag -->
        <g>
          <rect x="16" y="440" width="150" height="24" rx="12" fill="none"
                stroke="#4a5361" stroke-width="1"/>
          <text x="91" y="456" text-anchor="middle" fill="#8b949e"
                font-family="Arial, sans-serif" font-size="11" letter-spacing="2">PROTOTYPE RENDER</text>
        </g>
      </svg>
      <p class="zx-render-cap">Design prototype — final hardware may differ.</p>
    </div>
  </div>

  <div class="zx-vision">
    <h2 style="margin-top:0">The vision: AI for console players</h2>
    <p>PC players have had smart software between their hands and their games
    for years. Console players get whatever the pad in the box does. The EXO
    changes that: it is a small computer with a neural processor that sits
    between your controller and your console, sees the game the way you do —
    through the HDMI picture — and helps in real time.</p>
    <p><strong>Screen Assist</strong>, its flagship AI feature, watches the
    screen and steadies your aim over the last few degrees: it helps you
    <em>finish</em> a movement you started, and never makes one for you. It was
    built as an accessibility accommodation first — ZeroStick's founder is a
    disabled gamer — and that shows in every rule it follows: your thumb always
    wins, every limit is visible, and nothing runs that you didn't switch on.</p>
    <p>The same philosophy runs through the whole device: it can never make
    your controller worse. Every feature fails toward "your pad, untouched."</p>
  </div>

  <h2>What it does</h2>
  <div class="zx-cards">
    <div class="zx-card"><h3>Any input, any game</h3>
      <p>Xbox pads, DualSense, mouse &amp; keyboard — the EXO translates them
      all, with aim tuning designed around reduced mobility and precision.</p></div>
    <div class="zx-card"><h3>AI aim help on-device</h3>
      <p>Screen Assist runs on the EXO's own neural processor. No PC, no cloud,
      no game mods — it works from the picture alone.</p></div>
    <div class="zx-card"><h3>Runs your GPC scripts</h3>
      <p>Paste the Cronus-style scripts you already use — rapid fire,
      anti-recoil, button swaps — checked line by line before they run.</p></div>
    <div class="zx-card"><h3>Set up from your phone</h3>
      <p>Every binding, curve and script lives in a phone app. No PC software
      required to play.</p></div>
    <div class="zx-card"><h3>Smart Actions</h3>
      <p>Turbo, combos and timed sequences on one button — for hands that
      can't do claw grips and quarter-circle inputs.</p></div>
    <div class="zx-card"><h3>Fails safe, always</h3>
      <p>Servers down, subscription lapsed, script misbehaving — your
      controller keeps working. That rule is built into the hardware's
      design, not a promise.</p></div>
  </div>

  {%- if section.settings.show_pricing -%}
    <h2>What's free, what's paid</h2>
    <p><strong>Free:</strong> the controller, the bindings, the aim tuning,
    keyboard &amp; mouse play, Smart Actions, and GPC scripts — no account
    needed at all.</p>
    <p><strong>Subscription — Screen Assist only:</strong> the AI aim help is
    {{ section.settings.price_monthly | escape }}/month or
    {{ section.settings.price_yearly | escape }}/year, with a
    {{ section.settings.trial_days | escape }}-day free trial on a new account
    with a new device. Cancel any time; the device keeps working, always.</p>
  {%- endif -%}

  <p class="zx-fine">ZeroStick EXO is in active development — features and
  pricing may change before launch. The product image above is a design
  prototype render, not a photograph. GPC script compatibility is provided as
  an accessibility feature. Cronus Zen and XIM are trademarks of their
  respective owners, named here only for comparison; ZeroStick is not
  affiliated with, or endorsed by, either.</p>
</div>

{% schema %}
{
  "name": "ZeroStick EXO promo",
  "tag": "section",
  "settings": [
    {
      "type": "url",
      "id": "cta_link",
      "label": "Call-to-action link (hidden when empty)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Call-to-action label",
      "default": "Get launch updates"
    },
    {
      "type": "checkbox",
      "id": "show_pricing",
      "label": "Show pricing",
      "default": true
    },
    {
      "type": "text",
      "id": "price_monthly",
      "label": "Monthly price",
      "default": "$10"
    },
    {
      "type": "text",
      "id": "price_yearly",
      "label": "Yearly price",
      "default": "$99"
    },
    {
      "type": "text",
      "id": "trial_days",
      "label": "Trial length (days)",
      "default": "14"
    }
  ],
  "presets": [
    {
      "name": "ZeroStick EXO promo"
    }
  ]
}
{% endschema %}
