<script src="https://static.sketchfab.com/api/sketchfab-viewer-1.12.1.js"></script>
<script>
(function(){
  var BASE = 179; /* preorder base price - max fully-loaded build = $300 */
  var MODEL_UID = 'b1d054ee67204ec1984d5fbebd707cde';
  var api = null, groups = { shell: [], sticks: [], buttons: [], triggers: [], dpad: [] };

  /* EXACT material map for this model. Logo / Transparent / Emmissive / Port /
     Gold_Plates_Below / SPCB / Default_Material are never painted. */
  var MAP = {
    shell:    ['Side_Panels', 'Front_Panel', 'Front_Base', 'Back_Baseq'],
    sticks:   ['Thumb_Top'],
    buttons:  ['Buttons', 'FBCB'],
    triggers: ['Trigger_Buttons'],
    dpad:     ['Buttons']
  };

  function rgb(hex){ var n=parseInt(hex.slice(1),16); return [((n>>16)&255)/255,((n>>8)&255)/255,(n&255)/255].map(function(c){return Math.pow(c,2.2);}); }

  var originals = {};
  function paint(group, hex, stock){
    if(!api) return;
    groups[group].forEach(function(m){
      var o = originals[m.id] || {};
      if (stock) { m.channels.AlbedoPBR.texture = o.texture || null; m.channels.AlbedoPBR.color = o.color || false; }
      else { m.channels.AlbedoPBR.texture = null; m.channels.AlbedoPBR.color = rgb(hex); }
      api.setMaterial(m);
    });
  }
  function flash(group){
    if(!api || !groups[group] || !groups[group].length) return;
    groups[group].forEach(function(m){
      var prevT = m.channels.AlbedoPBR.texture, prevC = m.channels.AlbedoPBR.color;
      m.channels.AlbedoPBR.texture = null; m.channels.AlbedoPBR.color = [0.35, 0.75, 1.0];
      api.setMaterial(m);
      setTimeout(function(){ m.channels.AlbedoPBR.texture = prevT; m.channels.AlbedoPBR.color = prevC; api.setMaterial(m); }, 650);
    });
  }
  /* home camera captured at load; up-axis detected so orbits can't go crazy */
  var camHome = null, upIdx = 2;
  var CAM_OK = window.matchMedia('(min-width: 901px)').matches && !('ontouchstart' in window); /* auto-camera desktop-only: buggy on touch */
  function stepCam(view){
    if(!CAM_OK || !api || !camHome) return;
    var t = camHome.target.slice(), p = camHome.position.slice();
    var v = [p[0]-t[0], p[1]-t[1], p[2]-t[2]];
    var yaw = (view.yaw || 0) * Math.PI/180, zoom = view.zoom || 1;
    /* rotate v around the up axis */
    var a = (upIdx + 1) % 3, b = (upIdx + 2) % 3;
    var ca = Math.cos(yaw), sa = Math.sin(yaw);
    var ra = v[a]*ca - v[b]*sa, rb = v[a]*sa + v[b]*ca;
    v[a] = ra; v[b] = rb;
    /* lift = fraction of distance along up axis */
    var dist = Math.sqrt(v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);
    v[upIdx] += (view.lift || 0) * dist;
    var pos = [ t[0] + v[0]*zoom, t[1] + v[1]*zoom, t[2] + v[2]*zoom ];
    api.setCameraLookAt(pos, t, 1.0);
  }
  var STEP_CAMS = [
    { yaw: 20,  zoom: 1.0 },            /* 1 shell: three-quarter view */
    { yaw: 0,   zoom: 0.62 },           /* 2 sticks: close-up center */
    { yaw: -28, zoom: 0.72 },           /* 3 face buttons: right side close */
    { yaw: 12,  zoom: 0.8, lift: 0.45 },/* 4 triggers: from above */
    { yaw: 12,  zoom: 0.85, lift: 0.35 },/* 5 smart: top edge */
    { yaw: 180, zoom: 1.0 },            /* 6 rear: behind */
    { yaw: 0,   zoom: 1.0 }             /* 7 review: home */
  ];
  function pushIn(){
    if(!CAM_OK || !api) return;
    api.getCameraLookAt(function(err, cam){
      if (err) return;
      var p = cam.position, t = cam.target;
      var inPos = [ t[0]+(p[0]-t[0])*0.72, t[1]+(p[1]-t[1])*0.72, t[2]+(p[2]-t[2])*0.72 ];
      api.setCameraLookAt(inPos, t, 0.55);
      setTimeout(function(){ api.setCameraLookAt(p, t, 0.7); }, 1200);
    });
  }

  var client = new Sketchfab(document.getElementById('zsbApi'));
  client.init(MODEL_UID, {
    autostart: 1, autospin: 0, ui_theme: 'dark',
    success: function(a){
      api = a; api.start();
      api.addEventListener('viewerready', function(){
        api.getCameraLookAt(function(err, cam){
          if (!err) {
            camHome = { position: cam.position, target: cam.target };
            /* up axis = the smallest camera offset component (camera sits roughly level) */
            var d = [Math.abs(cam.position[0]-cam.target[0]), Math.abs(cam.position[1]-cam.target[1]), Math.abs(cam.position[2]-cam.target[2])];
            upIdx = d.indexOf(Math.min(d[0], d[1], d[2]));
            stepCam(STEP_CAMS[0]); /* frame step 1 once ready */
          }
        });
        window.ZSB_API = api; /* debug handle for camera tuning */
        api.getMaterialList(function(err, mats){
          if (err) return;
          window.ZSB = { mats: mats.map(function(m){ return m.name; }) };
          Object.keys(MAP).forEach(function(g){
            MAP[g].forEach(function(name){
              var m = mats.filter(function(x){ return x.name === name; })[0];
              if (m) {
                groups[g].push(m);
                if (!originals[m.id]) originals[m.id] = { texture: m.channels.AlbedoPBR.texture || null, color: m.channels.AlbedoPBR.color || false };
              }
            });
          });
        });
      });
    },
    error: function(){}
  });

  /* ── wizard ── */
  var steps = [].slice.call(document.querySelectorAll('.zsb-step'));
  var cur = 0;
  function showStep(n){
    cur = Math.max(0, Math.min(steps.length - 1, n));
    steps.forEach(function(s, i){ s.classList.toggle('active', i === cur); });
    document.getElementById('zsbStepNum').textContent = 'Step ' + (cur+1) + ' of ' + steps.length;
    document.getElementById('zsbFill').style.width = Math.round(((cur+1)/steps.length)*100) + '%';
    document.getElementById('zsbPrev').style.visibility = cur === 0 ? 'hidden' : 'visible';
    document.getElementById('zsbNext').style.display = cur === steps.length - 1 ? 'none' : 'block';
    rearPanel(); /* rear diagram only on the rear step */
    stepCam(STEP_CAMS[cur] || STEP_CAMS[0]); /* frame what this step customizes */
    if (cur === steps.length - 1) review();
  }
  document.getElementById('zsbNext').addEventListener('click', function(){ showStep(cur + 1); });
  document.getElementById('zsbPrev').addEventListener('click', function(){ showStep(cur - 1); });
  document.getElementById('zsbReset').addEventListener('click', function(){ location.reload(); });

  /* ── options state ── */
  var picks = { shell: {name:'Stock White', add:0}, sticks: {name:'Stock Black', add:0}, buttons: {name:'Stock', add:0}, triggers: {name:'Stock', add:0} };
  document.querySelectorAll('.zsb-paint').forEach(function(box){
    var g = box.dataset.group;
    box.querySelectorAll('.zsb-sw').forEach(function(s){
      s.addEventListener('click', function(){
        box.querySelectorAll('.zsb-sw').forEach(function(x){ x.classList.remove('active'); });
        s.classList.add('active');
        picks[g] = { name: s.dataset.name, add: +s.dataset.add };
        var lbl = document.querySelector('.zsb-swname[data-for="' + g + '"]'); if (lbl) lbl.textContent = s.dataset.name;
        paint(g, s.dataset.color, s.dataset.stock === '1');
        recalc();
      });
    });
  });

  function chips(){
    var el = document.getElementById('zsbChips'); el.innerHTML = '';
    document.querySelectorAll('.zsmart:checked').forEach(function(c){
      var d = document.createElement('div'); d.className = 'zsb-chip'; d.textContent = '+ ' + c.dataset.name; el.appendChild(d);
    });
    var rr = document.querySelector('input[name="zrear"]:checked');
    if (+rr.value > 0) { var d = document.createElement('div'); d.className = 'zsb-chip'; d.textContent = '+ ' + rr.dataset.name; el.appendChild(d); }
  }

  /* rear-view diagram: shows on the rear step when paddles are picked */
  function rearPanel(){
    var rr = document.querySelector('input[name="zrear"]:checked');
    var onRearStep = steps[cur] && steps[cur].id === 'zsbRearStep';
    var panel = document.getElementById('zsbRear');
    if (onRearStep && +rr.value > 0) {
      document.getElementById('zsbRearImg').src = "{{ 'zs-rear-2.png' | asset_url }}".replace('zs-rear-2', rr.dataset.name.indexOf('4') === 0 ? 'zs-rear-4' : 'zs-rear-2');
      panel.classList.add('show');
    } else {
      panel.classList.remove('show');
    }
  }

  document.querySelectorAll('.zsmart').forEach(function(c){
    c.addEventListener('change', function(){
      if (c.checked) { flash(c.dataset.focus); setTimeout(function(){ flash(c.dataset.focus); }, 800); }
      chips(); recalc();
    });
  });
  document.querySelectorAll('input[name="zrear"]').forEach(function(r){
    r.addEventListener('change', function(){ rearPanel(); chips(); recalc(); });
  });

  function money(n){ return '$' + n.toFixed(2).replace(/\.00$/, ''); }
  function lines(){
    var L = [
      ['Base build (TMR sticks installed)', BASE],
      ['Shell: ' + picks.shell.name, picks.shell.add],
      ['Stick caps: ' + picks.sticks.name + ' (OEM Edge)', picks.sticks.add],
      ['Face buttons: ' + picks.buttons.name, picks.buttons.add],
      ['Triggers/bumpers: ' + picks.triggers.name, picks.triggers.add]
    ];
    document.querySelectorAll('.zsmart:checked').forEach(function(c){ L.push([c.dataset.name, +c.value]); });
    var rr = document.querySelector('input[name="zrear"]:checked');
    if (+rr.value > 0) L.push(['Rear buttons: ' + rr.dataset.name, +rr.value]);
    return L;
  }
  function review(){
    var el = document.getElementById('zsbReview');
    el.innerHTML = lines().map(function(l){ return '<div class="zsb-sumrow"><span>' + l[0] + '</span><span>' + (l[1] ? '+' + money(l[1]) : (l[0].indexOf('Base') === 0 ? money(l[1] || BASE) : 'Included')) + '</span></div>'; }).join('');
  }
  function config(){
    var t = document.getElementById('zsbRun').textContent;
    return ['ZeroStick PS5 Builder preorder'].concat(lines().map(function(l){ return l[0] + (l[1] ? ' (+$' + l[1] + ')' : ''); })).concat(['Quoted total: ' + t]).join('\n');
  }
  function recalc(){
    var t = 0; lines().forEach(function(l){ t += l[1]; });
    document.getElementById('zsbRun').textContent = money(t);
    document.getElementById('zsbTotal').textContent = money(t);
    document.getElementById('zsbConfig').value = config();
    if (cur === steps.length - 1) review();
  }
  document.getElementById('zsbForm') && document.getElementById('zsbForm').addEventListener('submit', function(){ document.getElementById('zsbConfig').value = config(); });
  recalc(); chips(); showStep(0);
})();
</script>

{% schema %}
{
  "name": "ZeroStick 3D Builder",
  "settings": [],
  "presets": [{ "name": "ZeroStick 3D Builder" }]
}
{% endschema %}
