          <button type="button" class="zsb-sw" style="background:#6a2bd0" data-name="Purple" data-color="#6a2bd0" data-add="8"></button>
          <button type="button" class="zsb-sw" style="background:#d11a2a" data-name="Red" data-color="#d11a2a" data-add="8"></button>
