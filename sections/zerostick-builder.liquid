{%- comment -%}
  ZeroStick PS5 Controller Builder v4 - step wizard
  - Guided flow like the big builders: one question per step, Previous/Next/Reset, progress bar
  - Photoreal 3D via Sketchfab Viewer API ("Sony PS5 DualSense Controller" by be the knight, CC-BY)
  - Rear-buttons step shows a rear-view diagram with the paddles lit up
  - Preorder form emails the full build spec
{%- endcomment -%}

{%- assign ps5p = all_products['zerostick-pro-modified-controller-ps5'] -%}

<style>
  .zsb-wrap { max-width: 1500px; margin: 0 auto; padding: 48px 32px; }
  .zsb-head { margin-bottom: 28px; }
  .zsb-head h1 { font-size: clamp(30px, 4vw, 52px); font-weight: 800; text-transform: uppercase; }
  .zsb-head p { color: #717271; font-size: 16px; }
  .zsb-layout { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: start; }
  .zsb-stagebox { position: sticky; top: 100px; }
  .zsb-stage { position: relative; width: 100%; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: #0d1117; }
  .zsb-stage iframe { width: 100%; height: 100%; border: 0; }
  .zsb-chips { position: absolute; left: 10px; top: 10px; display: flex; flex-direction: column; gap: 6px; pointer-events: none; z-index: 5; }
  .zsb-chip { background: rgba(13,17,23,.85); border: 1px solid #298DDF; color: #fff; font-size: 12px; font-weight: 700; border-radius: 999px; padding: 6px 12px; animation: zsbPop .35s cubic-bezier(.2,1.6,.4,1) both; }
  @keyframes zsbPop { from { transform: scale(.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .zsb-rear { position: absolute; inset: 0; background: #0d1117; z-index: 6; display: none; }
  .zsb-rear.show { display: block; animation: zsbPop .3s ease both; }
  .zsb-rear img { width: 100%; height: 100%; object-fit: contain; }
  .zsb-credit { text-align: center; color: #999; font-size: 11px; margin-top: 8px; }
  .zsb-credit a { color: #298DDF; }
  .zsb-hint { text-align: center; color: #888; font-size: 12px; margin-top: 4px; }
  /* wizard chrome */
  .zsb-progress { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .zsb-progress-bar { flex: 1; height: 6px; background: #e8e8e8; border-radius: 999px; overflow: hidden; }
  .zsb-progress-fill { height: 100%; background: #298DDF; border-radius: 999px; transition: width .3s ease; }
  .zsb-stepnum { font-size: 12px; font-weight: 800; color: #717271; white-space: nowrap; }
  .zsb-step { display: none; }
  .zsb-step.active { display: block; animation: zsbPop .25s ease both; }
  .zsb-steptitle { font-size: 22px; font-weight: 800; text-transform: uppercase; margin: 14px 0 4px; }
  .zsb-sub { font-size: 13px; color: #8a8a8a; margin-bottom: 16px; }
  .zsb-included { display: inline-block; background: #e6f4ea; color: #0b7a3e; font-size: 11px; font-weight: 800; border-radius: 999px; padding: 3px 10px; margin-left: 8px; vertical-align: middle; }
  .zsb-swatches { display: flex; gap: 12px; flex-wrap: wrap; }
  .zsb-sw { width: 44px; height: 44px; border-radius: 50%; border: 2px solid #e0e0e0; cursor: pointer; padding: 0; transition: transform .12s; }
  .zsb-sw:hover { transform: scale(1.1); }
  .zsb-sw.active { border-color: #298DDF; box-shadow: 0 0 0 2px #298DDF; }
  .zsb-swname { margin-top: 10px; font-size: 13px; font-weight: 700; color: #298DDF; min-height: 18px; }
  .zsb-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; font-size: 15px; font-weight: 600; cursor: pointer; border-bottom: 1px solid #f0f0f0; }
  .zsb-row input { margin-right: 10px; accent-color: #298DDF; transform: scale(1.2); }
  .zsb-price { font-size: 13px; font-weight: 700; color: #717271; }
  .zsb-nav { display: flex; gap: 10px; margin-top: 24px; }
  .zsb-btn { padding: 13px 28px; border: none; border-radius: 28px; font-weight: 700; font-size: 15px; cursor: pointer; font-family: inherit; }
  .zsb-prev { background: #eef0f3; color: #2a2b2a; }
  .zsb-next { background: #0d1117; color: #fff; flex: 1; }
  .zsb-next:hover { background: #298DDF; }
  .zsb-reset { background: none; border: none; color: #999; font-size: 12px; font-weight: 700; cursor: pointer; text-decoration: underline; margin-left: auto; }
  .zsb-runningtotal { position: sticky; bottom: 0; background: #fff; border-top: 2px solid #0d1117; margin-top: 18px; padding: 12px 0; display: flex; justify-content: space-between; font-size: 18px; font-weight: 900; }
  /* review step */
  .zsb-summary { background: #f5f5f5; border-radius: 8px; padding: 24px; }
  .zsb-sumrow { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
  .zsb-total { font-size: 22px; font-weight: 900; border-top: 1px solid #e0e0e0; margin-top: 8px; padding-top: 14px; }
  .zsb-email { width: 100%; margin-top: 16px; padding: 13px 16px; border: 1px solid #d0d0d0; border-radius: 28px; font-size: 15px; font-family: inherit; }
  .zsb-add { width: 100%; margin-top: 10px; padding: 14px; border: none; border-radius: 28px; background: #0d1117; color: #fff; font-weight: 700; font-size: 15px; cursor: pointer; }
  .zsb-add:hover { background: #298DDF; }
  .zsb-success { background: #e6f4ea; color: #0b7a3e; border-radius: 8px; padding: 16px 20px; font-weight: 700; margin-bottom: 20px; }
  @media (max-width: 900px) { .zsb-layout { grid-template-columns: 1fr; } .zsb-stagebox { position: static; } }
</style>

<div class="zsb-wrap">
