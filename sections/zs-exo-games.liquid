<script>
  /* ==========================================================================
     Supported games page: page-only behaviour
     --------------------------------------------------------------------------
     The shared script (assets/zs-exo2.js) already does the reveal animation
     and the status filter. This adds, for this page only:
       1. the hero numbers counting up when they come into view
       2. the search box (works together with the status filter)
       3. the count tiles in the hero switching the filter
       4. the filter bar getting a stronger shadow while it is stuck
     Everything respects "reduced motion": no counting, no smooth scrolling.
     ========================================================================== */
  (function () {
    'use strict';
    var root = document.getElementById('zg-{{ sid }}');
    if (!root) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var hasIO = 'IntersectionObserver' in window;

    /* ---------- 1. count-up numbers ---------- */
    var nums = root.querySelectorAll('[data-zg-count]');
    function countUp(el, delay) {
      var end = parseInt(el.getAttribute('data-zg-count'), 10);
      var dur = 1400, start = null;
      function tick(now) {
        if (start === null) start = now + delay;
        var t = Math.max(0, Math.min(1, (now - start) / dur));
        var eased = 1 - Math.pow(1 - t, 4); // fast at first, gentle landing
        el.textContent = Math.round(end * eased);
        if (t < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }
    if (!reduce && hasIO && nums.length) {
      // Start from 0, then count up once the row is on screen.
      nums.forEach(function (el) { el.textContent = '0'; });
      var statsRow = root.querySelector('[data-zg-stats]');
      var countIO = new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;
        countIO.disconnect();
        nums.forEach(function (el, i) { countUp(el, 200 + i * 110); });
      }, { threshold: 0.35 });
      countIO.observe(statsRow);
    }

    /* ---------- 2. search ---------- */
    var browse = root.querySelector('[data-zg-browse]');
    var bar = browse && browse.querySelector('.x2-gamesbar');
    var grid = browse && browse.querySelector('.x2-games');
    var filter = bar && bar.querySelector('.x2-filter');
    if (!bar || !grid || !filter) return;
    var live = bar.querySelector('[aria-live]');
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.x2-game'));
    var search = root.querySelector('[data-zg-search]');
    var input = search.querySelector('input');
    var empty = root.querySelector('[data-zg-empty]');

    // Put the search box inside the sticky bar, next to the filter, and show it.
    bar.appendChild(search);
    search.hidden = false;

    // Short names people actually type, so "bo2", "cod", "2k" or "cs2" find
    // the right card. Keys are the card ids from snippets/zs-exo2-games.liquid.
    var ALIASES = {
      'game-cod-bo2': 'cod bo2 black ops 2 two',
      'game-cod-mw4': 'cod mw4 mw 4',
      'game-cod-warzone': 'cod wz',
      'game-nba-2k27': 'nba2k 2k27 2k basketball auto green',
      'game-cod-bo7': 'cod bo7',
      'game-apex-legends': 'apex',
      'game-battlefield-6': 'bf6 bf 6',
      'game-counter-strike-2': 'cs2 cs csgo cs go',
      'game-pubg': 'pubg playerunknowns',
      'game-rainbow-six-siege': 'r6 rainbow 6 siege x',
      'game-marvel-rivals': 'rivals',
      'game-overwatch': 'ow ow2 overwatch 2',
      'game-valorant': 'val',
      'game-cod-bo6': 'cod bo6',
      'game-cod-mw3': 'cod mw3 mw 3 modern warfare 3',
      'game-halo-infinite': 'halo',
      'game-gta-v': 'gta gta5 gta 5 grand theft auto 5',
      'game-helldivers-2': 'helldivers',
      'game-cyberpunk-2077': 'cyberpunk',
      'game-space-marine-2': 'space marine 40k warhammer 40k',
      'game-ea-sports-fc-27': 'fc fc27 fifa soccer football',
      'game-mlb-the-show-25': 'mlb the show baseball',
      'game-rocket-league': 'rl'
    };
    // lower-case, drop accents and punctuation: "Tom Clancy's" -> "tom clancy s"
    function norm(s) {
      s = String(s || '').toLowerCase();
      if (s.normalize) s = s.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      return s.replace(/[^a-z0-9]+/g, ' ').trim();
    }
    cards.forEach(function (c) {
      var name = c.querySelector('.x2-game-name');
      var sub = c.querySelector('.x2-game-sub');
      c.zgText = ' ' + norm((name ? name.textContent : '') + ' ' + (sub ? sub.textContent : '') + ' ' + (ALIASES[c.id] || '')) + ' ';
    });

    function currentStatus() {
      var on = filter.querySelector('button[aria-pressed="true"]');
      return on ? on.getAttribute('data-value') : 'all';
    }

    // Show/hide cards for the search words, then update the message and the
    // screen-reader count. The status filter (zs-exo2.js) uses the hidden
    // attribute; search uses the .zg-out class, so both work at once.
    function applySearch() {
      var q = norm(input.value);
      var words = q ? q.split(' ') : [];
      var shown = 0, elsewhere = 0;
      cards.forEach(function (c) {
        var match = words.every(function (w) { return c.zgText.indexOf(w) !== -1; });
        c.classList.toggle('zg-out', !match);
        if (!match) return;
        c.classList.add('is-in'); // make sure the reveal animation never leaves it invisible
        if (c.hidden) elsewhere++; else shown++;
      });
      empty.hidden = shown > 0;
      if (!shown) {
        empty.querySelector('[data-zg-q]').textContent = q ? '"' + input.value.trim() + '"' : 'this filter';
        var st = currentStatus();
        var label = { ready: 'Ready', progress: 'In progress', planned: 'Planned' }[st];
        empty.querySelector('[data-zg-where]').textContent = label ? ' in ' + label : '';
        empty.querySelector('[data-zg-elsewhere]').hidden = elsewhere === 0;
      }
      if (live) live.textContent = shown + (shown === 1 ? ' game shown' : ' games shown');
    }

    var typing;
    input.addEventListener('input', function () {
      clearTimeout(typing);
      typing = setTimeout(applySearch, 60); // tiny pause so fast typing stays smooth
    });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && input.value) { e.preventDefault(); input.value = ''; applySearch(); }
    });
    // The little x inside the box clears it: re-apply straight away.
    input.addEventListener('search', applySearch);
    // Enter on a phone keyboard: close the keyboard so the results are visible.
    input.addEventListener('keyup', function (e) { if (e.key === 'Enter') input.blur(); });

    // If you change the filter while scrolled down inside the grid, bring the
    // top of the (now shorter) grid back up under the sticky bar.
    function settle() {
      // Where the bottom of the bar sits while it is stuck: its sticky "top"
      // (the --zg-stick value in the CSS) plus its own height. Measured from
      // the CSS rather than the bar's current position, because a shorter
      // grid can un-stick the bar for a moment.
      var stickTop = parseFloat(getComputedStyle(bar).top) || 0;
      var barBottom = stickTop + bar.offsetHeight;
      var gridTop = grid.getBoundingClientRect().top;
      if (gridTop < barBottom) {
        window.scrollTo({ top: window.pageYOffset + gridTop - barBottom - 16, behavior: reduce ? 'auto' : 'smooth' });
      }
    }
    // zs-exo2.js handles the click itself (aria-pressed + hidden). We wait one
    // tick so it has finished, then re-apply the search on top of it.
    filter.addEventListener('click', function (e) {
      if (!e.target.closest('button[data-value]')) return;
      setTimeout(function () { applySearch(); settle(); }, 0);
    });
    root.querySelector('[data-zg-showall]').addEventListener('click', function () {
      var all = filter.querySelector('button[data-value="all"]');
      if (all) all.click();
    });

    /* ---------- 3. hero count tiles switch the filter ---------- */
    root.querySelectorAll('[data-zg-jump]').forEach(function (a) {
      a.addEventListener('click', function () {
        var btn = filter.querySelector('button[data-value="' + a.getAttribute('data-zg-jump') + '"]');
        if (btn && btn.getAttribute('aria-pressed') !== 'true') btn.click();
        // the link itself then scrolls down to the games (normal anchor link)
      });
    });

    /* ---------- 4. stronger shadow while the filter bar is stuck ---------- */
    // A 1px marker just above the bar: once it has scrolled off the top, the
    // bar is stuck. Checked at most once per frame while scrolling (cheap).
    // (a span, not a div: the theme hides every empty div)
    var marker = document.createElement('span');
    marker.setAttribute('aria-hidden', 'true');
    marker.style.cssText = 'display:block;height:1px;';
    bar.parentNode.insertBefore(marker, bar);
    var stuckTick = false;
    function checkStuck() {
      stuckTick = false;
      var gridEnd = grid.getBoundingClientRect().bottom;
      bar.classList.toggle('is-stuck', marker.getBoundingClientRect().top < 0 && gridEnd > bar.offsetHeight);
    }
    window.addEventListener('scroll', function () {
      if (!stuckTick) { stuckTick = true; requestAnimationFrame(checkStuck); }
    }, { passive: true });
    checkStuck();
  })();
</script>

