{% comment %}
  ZeroStick EXO manual — the shared shell for every manual page.

  The prose lives in each Shopify page body (edited in admin), exactly like
  zs-guide. This section adds the furniture a manual needs that a single page
  body can't carry:

    - a grouped sidebar listing every manual page, in reading order
    - an "On this page" list built from the page's own h2 headings
    - Previous / Next links following the sidebar order
    - callout and screenshot styling for the classes the page bodies use

  Screenshots are theme assets. Page bodies reference them as src="/zsimg/name.png";
  that prefix is swapped here for the theme's asset folder URL, so the
  pages never hard-code a theme ID that changes when the theme is republished.

  Pages are listed by handle in `manual_handles`; any handle without a published
  page is skipped, so the sidebar never links to a 404.
{% endcomment %}

{%- assign manual_handles = 'exo-manual,exo-quick-start,exo-pricing|exo-gaming-on-xbox,exo-gaming-on-ps5,exo-gaming-on-pc,exo-remote-play|exo-app-tour,exo-passthrough-mode,exo-aim-settings,exo-translation,exo-input-simulation,exo-settings-reference|exo-scripts,exo-script-timing,exo-smart-actions,exo-ai-scripts,exo-recoil-workshop,exo-studio|exo-troubleshooting' -%}
{%- assign group_names = 'Getting started|Setup|Using the app|Scripts &amp; AI|Help' | split: '|' -%}
{%- assign groups = manual_handles | split: '|' -%}

{%- comment -%} Flat reading order, existing pages only, for Previous / Next. {%- endcomment -%}
{%- assign order = '' -%}
{%- for g in groups -%}
  {%- assign hs = g | split: ',' -%}
  {%- for h in hs -%}
    {%- if pages[h].url -%}{%- assign order = order | append: h | append: ',' -%}{%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign order = order | split: ',' -%}
{%- assign prev_h = '' -%}{%- assign next_h = '' -%}
{%- for h in order -%}
  {%- if h == page.handle -%}
    {%- assign i_prev = forloop.index0 | minus: 1 -%}
    {%- assign i_next = forloop.index0 | plus: 1 -%}
    {%- if i_prev >= 0 -%}{%- assign prev_h = order[i_prev] -%}{%- endif -%}
    {%- assign next_h = order[i_next] -%}
  {%- endif -%}
{%- endfor -%}

{%- assign asset_base = 'zs-manual-base.txt' | asset_url | split: 'zs-manual-base.txt' | first -%}

<style>
  /* The theme's body overflow-x:hidden turns the body into a scroll box,
     which stops position:sticky (sidebar, tab bar) from working. clip hides
     the same overflow without that side effect. */
  body.template-page-exo-manual{ overflow-x:clip; overflow-y:visible; }
  .zsm{ --zsm-blue:#298DDF; display:grid; grid-template-columns:26rem minmax(0,1fr) 22rem;
    gap:4rem; max-width:140rem; margin:0 auto; padding:4rem 2rem 6rem; line-height:1.7; }
  .zsm-side{ position:sticky; top:2rem; align-self:start; max-height:calc(100vh - 4rem);
    overflow-y:auto; font-size:1.45rem; }
  .zsm-side h4{ margin:2rem 0 .6rem; font-size:1.15rem; letter-spacing:.08em;
    text-transform:uppercase; opacity:.6; }
  .zsm-side h4:first-child{ margin-top:0; }
  .zsm-side a{ display:block; padding:.45rem 1rem; border-radius:.6rem; color:inherit;
    text-decoration:none; opacity:.8; }
  .zsm-side a:hover{ opacity:1; background:rgba(var(--color-foreground),.05); }
  .zsm-side a.is-current{ opacity:1; font-weight:600; color:var(--zsm-blue);
    background:rgba(41,141,223,.1); }
  .zsm-main{ min-width:0; }
  .zsm-crumbs{ font-size:1.3rem; opacity:.65; margin:0 0 1.2rem; }
  .zsm-crumbs a{ color:inherit; }
  .zsm-main h1{ margin:0 0 2rem; line-height:1.15; }
  .zsm-body h2{ margin:4.4rem 0 1.2rem; line-height:1.25; scroll-margin-top:2rem; }
  .zsm-body h3{ margin:2.8rem 0 .8rem; }
  .zsm-body p, .zsm-body li{ font-size:1.6rem; }
  .zsm-body > p:first-child{ font-size:1.8rem; line-height:1.55; }
  .zsm-body ul, .zsm-body ol{ padding-left:2.2rem; margin:0 0 1.6rem; }
  .zsm-body li{ margin-bottom:.6rem; }
  .zsm-body table{ width:100%; border-collapse:collapse; margin:2rem 0; font-size:1.4rem;
    display:block; overflow-x:auto; }
  .zsm-body th, .zsm-body td{ text-align:left; padding:.9rem 1.1rem; vertical-align:top;
    border:.1rem solid rgba(var(--color-foreground),.16); }
  .zsm-body th{ background:rgba(var(--color-foreground),.05); font-weight:600; white-space:nowrap; }
  .zsm-body pre{ background:#0d1117; color:#e6edf3; padding:1.4rem 1.6rem; border-radius:.8rem;
    overflow-x:auto; font-size:1.35rem; line-height:1.5; }
  .zsm-body code{ font-size:.92em; }
  .zsm-body img{ max-width:100%; height:auto; border-radius:.8rem; margin:1.6rem 0 .4rem;
    border:.1rem solid rgba(var(--color-foreground),.14); }
  .zsm-body figure{ margin:2rem 0; }
  .zsm-body figcaption{ font-size:1.3rem; opacity:.7; }
  .zsm-body .zs-callout{ margin:2rem 0; padding:1.2rem 1.6rem; border-radius:.8rem;
    border-left:.4rem solid; font-size:1.5rem; background:rgba(var(--color-foreground),.04); }
  .zsm-body .zs-callout strong:first-child{ display:block; margin-bottom:.2rem; }
  .zsm-body .zs-tip{ border-color:#2ea043; }
  .zsm-body .zs-note{ border-color:var(--zsm-blue); }
  .zsm-body .zs-warn{ border-color:#d29922; }
  .zsm-toc{ position:sticky; top:2rem; align-self:start; font-size:1.35rem; }
  .zsm-toc h4{ margin:0 0 .8rem; font-size:1.15rem; letter-spacing:.08em;
    text-transform:uppercase; opacity:.6; }
  .zsm-toc a{ display:block; padding:.3rem 0 .3rem 1rem; color:inherit; opacity:.7;
    text-decoration:none; border-left:.2rem solid rgba(var(--color-foreground),.12); }
  .zsm-toc a:hover{ opacity:1; border-left-color:var(--zsm-blue); }
  .zsm-pager{ display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; margin:5rem 0 0;
    padding-top:2.4rem; border-top:.1rem solid rgba(var(--color-foreground),.14); }
  .zsm-pager a{ display:block; padding:1.4rem 1.6rem; border-radius:.9rem; color:inherit;
    text-decoration:none; border:.1rem solid rgba(var(--color-foreground),.16); }
  .zsm-pager a:hover{ border-color:var(--zsm-blue); }
  .zsm-pager small{ display:block; opacity:.6; font-size:1.2rem; }
  .zsm-pager .is-next{ text-align:right; grid-column:2; }
  .zsm{ grid-template-columns:26rem minmax(0,1fr); }
  .zsm-tabs{ position:sticky; top:0; z-index:3; display:flex; flex-wrap:nowrap; overflow-x:auto; gap:.6rem;
    margin:2.4rem 0 2rem; padding:1rem 0;
    border-bottom:.1rem solid rgba(var(--color-foreground),.14); scrollbar-width:thin; }
  .zsm-tab{ flex:0 0 auto; padding:.8rem 1.4rem; border-radius:99rem; cursor:pointer;
    font:inherit; font-size:1.4rem; color:inherit; background:transparent;
    border:.1rem solid rgba(var(--color-foreground),.18); }
  .zsm-tab:hover{ border-color:var(--zsm-blue); }
  .zsm-tab.is-on{ background:var(--zsm-blue); border-color:var(--zsm-blue); color:#fff; font-weight:600; }
  .zsm-panel{ scroll-margin-top:12rem; }
  .zsm-panel > h2{ margin-top:4.4rem; }
  .zsm-panel:first-of-type > h2{ margin-top:1rem; }
  .zsm-nexttab{ margin-top:3rem; }
  .zsm-subtabs{ margin:.2rem 0 .8rem 1.2rem; padding-left:.8rem;
    border-left:.2rem solid rgba(41,141,223,.35); }
  .zsm-subtabs a{ padding:.3rem .8rem; font-size:1.3rem; }
  .zsm-subtabs a.is-on{ color:var(--zsm-blue); opacity:1; font-weight:600; }
  .zsm-toc{ display:none !important; }
  .zsm-menu-btn{ display:none; }
  @media (max-width:1199px){
    .zsm{ grid-template-columns:24rem minmax(0,1fr); }
    .zsm-toc{ display:none; }
  }
  @media (max-width:899px){
    .zsm{ display:block; padding-top:2rem; }
    .zsm-menu-btn{ display:block; width:100%; margin:0 0 1.6rem; }
    .zsm-side{ display:none; position:static; max-height:none; margin:0 0 2rem;
      padding:1.4rem; border:.1rem solid rgba(var(--color-foreground),.16); border-radius:.9rem; }
    .zsm-side.is-open{ display:block; }
  }
</style>

<div class="zsm">
  <button type="button" class="button button--secondary zsm-menu-btn"
          onclick="document.querySelector('.zsm-side').classList.toggle('is-open')">
    EXO manual — all pages
  </button>

  <nav class="zsm-side" aria-label="EXO manual">
    {%- for g in groups -%}
      <h4>{{ group_names[forloop.index0] }}</h4>
      {%- assign hs = g | split: ',' -%}
      {%- for h in hs -%}
        {%- assign mp = pages[h] -%}
        {%- if mp.url -%}
          <a href="{{ mp.url }}"{% if h == page.handle %} class="is-current" aria-current="page"{% endif %}>{{ mp.title | escape }}</a>
          {%- if h == page.handle -%}<div class="zsm-subtabs" data-zsm-subtabs></div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </nav>

  <article class="zsm-main">
    <nav class="zsm-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> <span aria-hidden="true">/</span>
      {%- if page.handle != 'exo-manual' and pages['exo-manual'].url %}
        <a href="{{ pages['exo-manual'].url }}">EXO manual</a> <span aria-hidden="true">/</span>
      {%- endif %}
      <span>{{ page.title | escape }}</span>
    </nav>
    <h1>{{ page.title | escape }}</h1>
    <div class="zsm-body">
      {%- comment -%} The case's port is printed AUTH; early drafts called it PS5 AUTH. {%- endcomment -%}
      {{ page.content | replace: '/zsimg/', asset_base | replace: 'zsimg:', asset_base | replace: 'PS5 AUTH', 'AUTH' }}
    </div>

    <div class="zsm-pager">
      {%- if prev_h != '' -%}
        <a href="{{ pages[prev_h].url }}"><small>Previous</small>{{ pages[prev_h].title | escape }}</a>
      {%- endif -%}
      {%- if next_h != '' and pages[next_h].url -%}
        <a class="is-next" href="{{ pages[next_h].url }}"><small>Next</small>{{ pages[next_h].title | escape }}</a>
      {%- endif -%}
    </div>
  </article>

  <aside class="zsm-toc" aria-label="On this page"><h4>On this page</h4><div data-zsm-toc></div></aside>
</div>

<script>
  /* Tabs: every h2 in the page body becomes a tab, so a page shows one
     topic at a time. Text before the first h2 stays above the tab bar as
     the page's summary. The sidebar lists the same tabs under the current
     page, and #tab-name in the URL opens that tab directly. */
  (function () {
    var body = document.querySelector('.zsm-body');
    var heads = body ? body.querySelectorAll(':scope > h2') : [];
    var toc = document.querySelector('.zsm-toc');
    if (toc) toc.style.display = 'none';
    if (heads.length < 2) return;

    var slug = function (t, i) {
      return (t || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'tab-' + i;
    };
    var panels = [], bar = document.createElement('div');
    bar.className = 'zsm-tabs'; bar.setAttribute('role', 'tablist');
    var side = document.querySelector('[data-zsm-subtabs]');

    /* Short tab labels: the first section is the Overview, "(Advanced view)"
       style notes drop off, and sections sharing a "Prefix:" (e.g. five
       "Walkthrough: ..." sections) share one tab named after the prefix. */
    var labelOf = function (t, i) {
      if (i === 0) return { label: 'Overview', group: null };
      var m = t.match(/^([^:]{2,24}):\s/);
      if (m) return { label: m[1].trim().replace(/([^s])$/, '$1s'), group: m[1].trim() };
      return { label: t.replace(/\s*\([^)]*\)\s*$/, '').trim(), group: null };
    };
    heads.forEach(function (h, i) {
      var info = labelOf(h.textContent, i);
      var last = panels[panels.length - 1];
      var panel;
      if (info.group && last && last.group === info.group) {
        panel = last.panel;
      } else {
        panel = document.createElement('section');
        panel.className = 'zsm-panel'; panel.id = slug(info.label, i); panel.setAttribute('role', 'tabpanel');
        h.parentNode.insertBefore(panel, h);
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'zsm-tab'; b.setAttribute('role', 'tab');
        b.textContent = info.label; b.dataset.id = panel.id;
        bar.appendChild(b);
        if (side) {
          var a = document.createElement('a'); a.href = '#' + panel.id; a.textContent = info.label; a.dataset.id = panel.id;
          side.appendChild(a);
        }
        panels.push({ id: panel.id, panel: panel, tab: b, title: info.label, group: info.group });
      }
      var n = h;
      while (n && !(n !== h && n.nodeType === 1 && n.tagName === 'H2' && n.parentNode === body)) {
        var next = n.nextSibling; panel.appendChild(n); n = next;
      }
    });
    body.insertBefore(bar, panels[0].panel);

    /* Every section stays on the page. The tab bar sticks to the top while
       you read, and the highlighted tab (and the sidebar entry) follows the
       section you're in. Clicking a tab jumps to its section. */
    var bg = 'transparent', el = bar.parentNode;
    while (el && el !== document.documentElement) {
      var c = getComputedStyle(el).backgroundColor;
      if (c && c !== 'transparent' && !/rgba\(.*,\s*0\)$/.test(c)) { bg = c; break; }
      el = el.parentNode;
    }
    bar.style.background = bg === 'transparent' ? getComputedStyle(document.body).backgroundColor : bg;

    var current = null;
    function mark(p) {
      if (!p || p === current) return;
      current = p;
      panels.forEach(function (q) {
        var on = q === p;
        q.tab.classList.toggle('is-on', on);
        q.tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (side) side.querySelectorAll('a').forEach(function (a) { a.classList.toggle('is-on', a.dataset.id === p.id); });
      if (history.replaceState) history.replaceState(null, '', '#' + p.id);
      bar.scrollTo({ left: p.tab.offsetLeft - bar.clientWidth / 2 + p.tab.offsetWidth / 2, behavior: 'smooth' });
    }
    function offset() { return bar.getBoundingClientRect().height + 16; }
    function jump(id) {
      var p = panels.filter(function (q) { return q.id === id; })[0];
      if (!p) return;
      var y = p.panel.getBoundingClientRect().top + window.pageYOffset - offset();
      window.scrollTo({ top: y, behavior: 'smooth' });
      mark(p);
    }
    function spy() {
      var line = offset() + 40, hit = panels[0];
      panels.forEach(function (p) { if (p.panel.getBoundingClientRect().top <= line) hit = p; });
      if ((window.innerHeight + window.pageYOffset) >= document.body.scrollHeight - 4) hit = panels[panels.length - 1];
      mark(hit);
    }
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return; ticking = true;
      requestAnimationFrame(function () { ticking = false; spy(); });
    }, { passive: true });

    bar.addEventListener('click', function (e) { var b = e.target.closest('.zsm-tab'); if (b) jump(b.dataset.id); });
    if (side) side.addEventListener('click', function (e) {
      var a = e.target.closest('a'); if (!a) return; e.preventDefault(); jump(a.dataset.id);
      var sb = document.querySelector('.zsm-side'); if (sb) sb.classList.remove('is-open');
    });
    if (location.hash) setTimeout(function () { jump(location.hash.slice(1)); }, 50); else spy();
  })();
</script>

{%- if page.title -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "TechArticle",
  "headline": {{ page.title | json }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ page.url | prepend: request.origin | json }} },
  "author": { "@type": "Organization", "name": {{ shop.name | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ request.origin | json }} },
  "about": "ZeroStick EXO",
  "description": {{ page.content | strip_html | strip_newlines | truncate: 300 | json }}
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "ZeroStick EXO manual",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
