{% comment %}
  ZeroStick EXO manual — the shared shell for every manual page.

  The prose lives in each Shopify page body (edited in admin), exactly like
  zs-guide. This section adds the furniture a manual needs that a single page
  body can't carry:

    - a grouped sidebar listing every manual page, in reading order
    - an "On this page" list built from the page's own h2 headings
    - Previous / Next links following the sidebar order
    - callout and screenshot styling for the classes the page bodies use

  Screenshots are theme assets. Page bodies reference them as src="zsimg:name.png";
  the zsimg: prefix is swapped here for the theme's asset folder URL, so the
  pages never hard-code a theme ID that changes when the theme is republished.

  Pages are listed by handle in `manual_handles`; any handle without a published
  page is skipped, so the sidebar never links to a 404.
{% endcomment %}

{%- assign manual_handles = 'exo-manual,exo-quick-start,exo-pricing|exo-gaming-on-xbox,exo-gaming-on-ps5,exo-gaming-on-pc,exo-remote-play|exo-app-tour,exo-aim-settings,exo-translation,exo-input-simulation,exo-settings-reference|exo-scripts,exo-script-timing,exo-smart-actions,exo-ai-scripts,exo-recoil-workshop,exo-studio|exo-troubleshooting' -%}
{%- assign group_names = 'Getting started|Setup|Using the app|Scripts &amp; AI|Help' | split: '|' -%}
{%- assign groups = manual_handles | split: '|' -%}

{%- comment -%} Flat reading order, existing pages only, for Previous / Next. {%- endcomment -%}
{%- assign order = '' -%}
{%- for g in groups -%}
  {%- assign hs = g | split: ',' -%}
  {%- for h in hs -%}
    {%- if pages[h].url -%}{%- assign order = order | append: h | append: ',' -%}{%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign order = order | split: ',' -%}
{%- assign prev_h = '' -%}{%- assign next_h = '' -%}
{%- for h in order -%}
  {%- if h == page.handle -%}
    {%- assign i_prev = forloop.index0 | minus: 1 -%}
    {%- assign i_next = forloop.index0 | plus: 1 -%}
    {%- if i_prev >= 0 -%}{%- assign prev_h = order[i_prev] -%}{%- endif -%}
    {%- assign next_h = order[i_next] -%}
  {%- endif -%}
{%- endfor -%}

{%- assign asset_base = 'zs-manual-base.txt' | asset_url | split: 'zs-manual-base.txt' | first -%}

<style>
  .zsm{ --zsm-blue:#298DDF; display:grid; grid-template-columns:26rem minmax(0,1fr) 22rem;
    gap:4rem; max-width:140rem; margin:0 auto; padding:4rem 2rem 6rem; line-height:1.7; }
  .zsm-side{ position:sticky; top:2rem; align-self:start; max-height:calc(100vh - 4rem);
    overflow-y:auto; font-size:1.45rem; }
  .zsm-side h4{ margin:2rem 0 .6rem; font-size:1.15rem; letter-spacing:.08em;
    text-transform:uppercase; opacity:.6; }
  .zsm-side h4:first-child{ margin-top:0; }
  .zsm-side a{ display:block; padding:.45rem 1rem; border-radius:.6rem; color:inherit;
    text-decoration:none; opacity:.8; }
  .zsm-side a:hover{ opacity:1; background:rgba(var(--color-foreground),.05); }
  .zsm-side a.is-current{ opacity:1; font-weight:600; color:var(--zsm-blue);
    background:rgba(41,141,223,.1); }
  .zsm-main{ min-width:0; }
  .zsm-crumbs{ font-size:1.3rem; opacity:.65; margin:0 0 1.2rem; }
  .zsm-crumbs a{ color:inherit; }
  .zsm-main h1{ margin:0 0 2rem; line-height:1.15; }
  .zsm-body h2{ margin:4.4rem 0 1.2rem; line-height:1.25; scroll-margin-top:2rem; }
  .zsm-body h3{ margin:2.8rem 0 .8rem; }
  .zsm-body p, .zsm-body li{ font-size:1.6rem; }
  .zsm-body > p:first-child{ font-size:1.8rem; line-height:1.55; }
  .zsm-body ul, .zsm-body ol{ padding-left:2.2rem; margin:0 0 1.6rem; }
  .zsm-body li{ margin-bottom:.6rem; }
  .zsm-body table{ width:100%; border-collapse:collapse; margin:2rem 0; font-size:1.4rem;
    display:block; overflow-x:auto; }
  .zsm-body th, .zsm-body td{ text-align:left; padding:.9rem 1.1rem; vertical-align:top;
    border:.1rem solid rgba(var(--color-foreground),.16); }
  .zsm-body th{ background:rgba(var(--color-foreground),.05); font-weight:600; white-space:nowrap; }
  .zsm-body pre{ background:#0d1117; color:#e6edf3; padding:1.4rem 1.6rem; border-radius:.8rem;
    overflow-x:auto; font-size:1.35rem; line-height:1.5; }
  .zsm-body code{ font-size:.92em; }
  .zsm-body img{ max-width:100%; height:auto; border-radius:.8rem; margin:1.6rem 0 .4rem;
    border:.1rem solid rgba(var(--color-foreground),.14); }
  .zsm-body figure{ margin:2rem 0; }
  .zsm-body figcaption{ font-size:1.3rem; opacity:.7; }
  .zsm-body .zs-callout{ margin:2rem 0; padding:1.2rem 1.6rem; border-radius:.8rem;
    border-left:.4rem solid; font-size:1.5rem; background:rgba(var(--color-foreground),.04); }
  .zsm-body .zs-callout strong:first-child{ display:block; margin-bottom:.2rem; }
  .zsm-body .zs-tip{ border-color:#2ea043; }
  .zsm-body .zs-note{ border-color:var(--zsm-blue); }
  .zsm-body .zs-warn{ border-color:#d29922; }
  .zsm-toc{ position:sticky; top:2rem; align-self:start; font-size:1.35rem; }
  .zsm-toc h4{ margin:0 0 .8rem; font-size:1.15rem; letter-spacing:.08em;
    text-transform:uppercase; opacity:.6; }
  .zsm-toc a{ display:block; padding:.3rem 0 .3rem 1rem; color:inherit; opacity:.7;
    text-decoration:none; border-left:.2rem solid rgba(var(--color-foreground),.12); }
  .zsm-toc a:hover{ opacity:1; border-left-color:var(--zsm-blue); }
  .zsm-pager{ display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; margin:5rem 0 0;
    padding-top:2.4rem; border-top:.1rem solid rgba(var(--color-foreground),.14); }
  .zsm-pager a{ display:block; padding:1.4rem 1.6rem; border-radius:.9rem; color:inherit;
    text-decoration:none; border:.1rem solid rgba(var(--color-foreground),.16); }
  .zsm-pager a:hover{ border-color:var(--zsm-blue); }
  .zsm-pager small{ display:block; opacity:.6; font-size:1.2rem; }
  .zsm-pager .is-next{ text-align:right; grid-column:2; }
  .zsm-menu-btn{ display:none; }
  @media (max-width:1199px){
    .zsm{ grid-template-columns:24rem minmax(0,1fr); }
    .zsm-toc{ display:none; }
  }
  @media (max-width:899px){
    .zsm{ display:block; padding-top:2rem; }
    .zsm-menu-btn{ display:block; width:100%; margin:0 0 1.6rem; }
    .zsm-side{ display:none; position:static; max-height:none; margin:0 0 2rem;
      padding:1.4rem; border:.1rem solid rgba(var(--color-foreground),.16); border-radius:.9rem; }
    .zsm-side.is-open{ display:block; }
  }
</style>

<div class="zsm">
  <button type="button" class="button button--secondary zsm-menu-btn"
          onclick="document.querySelector('.zsm-side').classList.toggle('is-open')">
    EXO manual — all pages
  </button>

  <nav class="zsm-side" aria-label="EXO manual">
    {%- for g in groups -%}
      <h4>{{ group_names[forloop.index0] }}</h4>
      {%- assign hs = g | split: ',' -%}
      {%- for h in hs -%}
        {%- assign mp = pages[h] -%}
        {%- if mp.url -%}
          <a href="{{ mp.url }}"{% if h == page.handle %} class="is-current" aria-current="page"{% endif %}>{{ mp.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </nav>

  <article class="zsm-main">
    <nav class="zsm-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> <span aria-hidden="true">/</span>
      {%- if page.handle != 'exo-manual' and pages['exo-manual'].url %}
        <a href="{{ pages['exo-manual'].url }}">EXO manual</a> <span aria-hidden="true">/</span>
      {%- endif %}
      <span>{{ page.title | escape }}</span>
    </nav>
    <h1>{{ page.title | escape }}</h1>
    <div class="zsm-body">
      {{ page.content | replace: 'zsimg:', asset_base }}
    </div>

    <div class="zsm-pager">
      {%- if prev_h != '' -%}
        <a href="{{ pages[prev_h].url }}"><small>Previous</small>{{ pages[prev_h].title | escape }}</a>
      {%- endif -%}
      {%- if next_h != '' and pages[next_h].url -%}
        <a class="is-next" href="{{ pages[next_h].url }}"><small>Next</small>{{ pages[next_h].title | escape }}</a>
      {%- endif -%}
    </div>
  </article>

  <aside class="zsm-toc" aria-label="On this page"><h4>On this page</h4><div data-zsm-toc></div></aside>
</div>

<script>
  (function () {
    var box = document.querySelector('[data-zsm-toc]');
    var heads = document.querySelectorAll('.zsm-body h2');
    if (!box || heads.length < 2) { var t = document.querySelector('.zsm-toc'); if (t) t.style.display = 'none'; return; }
    heads.forEach(function (h, i) {
      if (!h.id) h.id = (h.textContent || 'section').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section-' + i;
      var a = document.createElement('a'); a.href = '#' + h.id; a.textContent = h.textContent; box.appendChild(a);
    });
  })();
</script>

{%- if page.title -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "TechArticle",
  "headline": {{ page.title | json }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ page.url | prepend: request.origin | json }} },
  "author": { "@type": "Organization", "name": {{ shop.name | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ request.origin | json }} },
  "about": "ZeroStick EXO",
  "description": {{ page.content | strip_html | strip_newlines | truncate: 300 | json }}
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "ZeroStick EXO manual",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
