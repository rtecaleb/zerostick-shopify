{% comment %}
  ==========================================================================
  ZeroStick EXO: landing page v2 (staged, not live until Caleb assigns it)
  --------------------------------------------------------------------------
  Template: templates/page.zerostick-exo-v2.json
  Preview:  https://zerostickgaming.com/pages/zerostick-exo?view=zerostick-exo-v2

  What this file loads
    assets/zs-exo2.css          shared EXO design system (colours, buttons, cards,
                                sticky phone story, FAQ, port viewer...). Shared with
                                other EXO pages, so do NOT edit it for this page.
    assets/zs-exo2-landing.css  styles only this page uses (all start with x2l-)
    assets/zs-exo2.js           shared behaviour (reveal on scroll, sticky story,
                                lazy 3D model, port viewer, games list)
    assets/zs-exo2-landing.js   this page's extras (scroll motion, page nav,
                                number count-up, exploded-view sequence)

  Product pictures and the 3D model ALWAYS come through
  snippets/zs-exo2-visual.liquid (the one swap point). App screenshots are
  real phone captures, copied from C:\zsg\overhaul\app-shots\clean as
  assets/exo2-app-<key>.webp. Never replace them with drawn/mocked UI.

  The page, top to bottom
    0. page nav        1. hero (3D)        1b. numbers
    2. what it does (animated signal-flow diagram)
    3. the app (sticky phone story)        4. automatic gun detection
    5. aim             6. Scripts          7. everything you play with
    8. hardware (exploded sequence, 3D port viewer, specs, in the box)
    9. supported games 10. pre-order       11. FAQ + fine print

  Copy rules (from C:\zsg\overhaul\BRIEF.md): product name "ZeroStick EXO";
  prices $149.99 Xbox / $169.99 PS5; ships January 1, 2027; no subscription,
  no account; "Measured aim curve" only for Black Ops II, MW4 and Warzone;
  check BRIEF.md before adding any new claim.
  ==========================================================================
{% endcomment %}

{%- liquid
  # ---- links (edit them in the theme editor: Customize > this section) ----
  assign preorder_url = section.settings.preorder_url | default: '/products/zerostick-exo'
  assign games_url = section.settings.games_url | default: '/pages/supported-games'
  assign manual_url = section.settings.manual_url | default: '/pages/exo-manual'
  # The Discord invite isn't known yet: the default is a placeholder anchor.
  assign discord_url = section.settings.discord_url | default: '#discord-invite-placeholder'
  # App store links aren't known yet. While a link still starts with "#"
  # (a placeholder) its button is hidden, so customers never hit a dead link.
  assign app_store_url = section.settings.app_store_url | default: '#app-store-placeholder'
  assign play_store_url = section.settings.play_store_url | default: '#play-store-placeholder'
  assign app_store_ready = true
  assign app_first = app_store_url | slice: 0
  if app_first == '#'
    assign app_store_ready = false
  endif
  assign play_store_ready = true
  assign play_first = play_store_url | slice: 0
  if play_first == '#'
    assign play_store_ready = false
  endif

  # FCC notice: OFF by default. When ticked it shows (word for word) next to
  # the price / pre-order buttons and again in the fine print.
  assign fcc_text = 'This device has not been authorized as required by the rules of the Federal Communications Commission. This device is not, and may not be, offered for sale or lease, or sold or leased, until authorization is obtained.'

  # The pre-order promise, used beside every pre-order button.
  assign ship_line = "Ships January 1, 2027. If that date changes we'll email you, and you can cancel for a full refund."
-%}

