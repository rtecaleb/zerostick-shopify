          <path d="M20 200 H240 L300 260 H520"/>
          <path d="M20 260 H200 L260 320 H480 L520 360"/>
          <path d="M20 500 H180 L240 440 H460"/>
          <path d="M20 560 H300 L360 500 H560"/>
          <path d="M640 180 V300 L700 360 V520"/>
          <path d="M760 200 V280 L820 340 V480"/>
        </g>
        <!-- pads and vias -->
        <g fill="#c9a86a" opacity=".9">
          <circle cx="240" cy="200" r="7"/><circle cx="200" cy="260" r="7"/>
          <circle cx="180" cy="500" r="7"/><circle cx="300" cy="560" r="7"/>
          <circle cx="640" cy="180" r="7"/><circle cx="760" cy="200" r="7"/>
          <circle cx="520" cy="200" r="7"/><circle cx="560" cy="500" r="7"/>
        </g>
        <!-- stick-mechanism footprints -->
        <g stroke="#c9a86a" fill="none" stroke-width="3" opacity=".85">
          <circle cx="180" cy="360" r="58"/>
          <circle cx="180" cy="360" r="34"/>
          <circle cx="180" cy="360" r="10" fill="#c9a86a"/>
          <circle cx="620" cy="430" r="58"/>
          <circle cx="620" cy="430" r="34"/>
          <circle cx="620" cy="430" r="10" fill="#c9a86a"/>
        </g>
        <!-- the processor -->
        <g>
          <rect x="380" y="300" width="120" height="120" rx="8"
                fill="#05070c" stroke="#2c3b55" stroke-width="2"/>
          <g stroke="#c9a86a" stroke-width="3" opacity=".8">
            <path d="M380 320 h-24 M380 350 h-24 M380 380 h-24 M380 410 h-24"/>
            <path d="M500 320 h24 M500 350 h24 M500 380 h24 M500 410 h24"/>
          </g>
          <text x="440" y="352" text-anchor="middle" fill="#58a6ff"
                font-family="Arial, sans-serif" font-size="17" font-weight="700"
                letter-spacing="2">ZS-8K</text>
          <text x="440" y="378" text-anchor="middle" fill="#4a5a75"
