{% comment %}
  ZeroStick 8K — business-inquiry page (the "8K for Business" tab).

  The 8K controller is finished, so this page turned from a coming-soon
  teaser into a B2B page: other companies can buy Lightning boards in
  bulk, integrate them into their own products (OEM), or resell.

  Layout: the same full-bleed PCB hero (our own inline-SVG render), a
  short "the board is finished" mission, the four-card feature strip,
  three ways-to-work-with-us cards, a business-inquiry form (Shopify
  contact form — submissions email the store inbox), the ZS8K
  Configurator block (id="app" — see below), a B2B FAQ, and fine print.
  All styles scoped under .zx8; the hero is deliberately self-coloured
  (a PCB is a PCB in any theme scheme).

  The ZS8K Configurator block is where owners of a finished controller
  land: the controller's read-only ZS8K SETUP drive carries a shortcut
  to https://zerostickgaming.com/pages/8k-controllers#app, so id="app"
  must never change. It only claims what the app really does.
{% endcomment %}

<style>
  .zx8{ line-height:1.6; }
  .zx8 .hero{ position:relative; background:#05070c; }
  .zx8 .hero svg{ display:block; width:100%; height:auto; }
  .zx8 .inner{ max-width:110rem; margin:0 auto; padding:0 2rem; }
  .zx8 h2{ margin:4.4rem 0 1rem; }
  .zx8 h3{ margin:0 0 .6rem; }
  .zx8 .mission{ font-size:1.7rem; opacity:.85; max-width:76rem; margin:3.2rem auto 0; }
  .zx8 .mission p{ margin:0 0 1.2rem; }
  .zx8 .strip{ display:grid; grid-template-columns:repeat(auto-fit,minmax(22rem,1fr));
    gap:1.4rem; margin:2rem 0; }
  .zx8 .feat{ border:.1rem solid rgba(var(--color-foreground),.14);
    border-radius:1.2rem; padding:1.8rem 2rem; }
  .zx8 .feat .ico{ font-size:2rem; line-height:1; margin-bottom:.8rem; color:#58a6ff; }
  .zx8 .feat p{ margin:0; opacity:.75; font-size:1.4rem; }
  .zx8 .ways{ display:grid; grid-template-columns:repeat(auto-fit,minmax(24rem,1fr));
    gap:1.4rem; margin:2rem 0; }
  .zx8 .way{ border:.1rem solid rgba(var(--color-foreground),.14);
    border-radius:1.2rem; padding:1.8rem 2rem; display:flex; flex-direction:column; }
  .zx8 .way p{ opacity:.75; font-size:1.4rem; flex:1; }
  .zx8 .way .tag{ display:inline-block; align-self:flex-start; font-size:1.1rem;
    font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    border:.1rem solid rgba(var(--color-foreground),.25); border-radius:99rem;
    padding:.3rem 1rem; margin-bottom:1rem; opacity:.8; }
  .zx8 details{ border:.1rem solid rgba(var(--color-foreground),.14);
    border-radius:1rem; padding:1.2rem 1.6rem; margin:0 0 1rem; }
  .zx8 summary{ font-weight:600; cursor:pointer; font-size:1.5rem; }
  .zx8 details p{ margin:.8rem 0 0; opacity:.78; font-size:1.45rem; }
  .zx8 .fine{ font-size:1.3rem; opacity:.65; margin:4rem 0 0;
    border-top:.1rem solid rgba(var(--color-foreground),.12); padding-top:1.6rem; }
  .zx8 .cta-row{ display:flex; flex-wrap:wrap; gap:1.2rem; margin:2rem 0; }

  /* --- business-inquiry form --- */
  .zx8 .biz{ max-width:76rem; margin:0 auto; }
  .zx8 .biz-lead{ opacity:.78; font-size:1.5rem; margin:0 0 2rem; }
  .zx8 .bizgrid{ display:grid; grid-template-columns:1fr 1fr; gap:1.4rem; }
  .zx8 .bizgrid .span2{ grid-column:1 / -1; }
  @media screen and (max-width: 749px){
    .zx8 .bizgrid{ grid-template-columns:1fr; }
  }
  /* A <select> can't float Dawn's label the way text inputs do (no
     :placeholder-shown on selects), so pin its label in the "shrunk"
     position and pad the select to match a filled text field. */
  .zx8 .field--select .field__label{ font-size:1rem; top:.5rem;
    letter-spacing:.04em; }
  .zx8 .field--select select.field__input{ padding:2.2rem 1.5rem .8rem 2rem;
    width:100%; cursor:pointer;
    /* 4.5rem (Dawn's default) clips the value's descenders by 1px under the
       pinned label; the qty input beside it flex-grows to match, so the row
       stays even. */
    min-height:5rem; }
  .zx8 .biz-direct{ font-size:1.4rem; opacity:.75; margin:1.6rem 0 0; }

  /* --- ZS8K Configurator block (#app) ---
     A little air above the heading when the setup drive's link lands on
     #app. The header scrolls away with the page (zs-main.css marks it
     sticky, but its section wrapper is only as tall as the header, so it
     never sticks); if it is ever made truly sticky, raise this to about
     18rem so the heading is not hidden under it. */
  .zx8 .app{ scroll-margin-top:2.4rem; }
  .zx8 .app-lead{ font-size:1.7rem; opacity:.85; max-width:76rem; margin:0; }
  .zx8 .app .cta-row{ align-items:center; }
  .zx8 .app-meta{ font-size:1.4rem; margin:0; }
  /* links in the new copy use the page's accent: Dawn's .link blue drops
     under 4.5:1 on this navy once the mission's opacity dims it */
  .zx8 .app .link, .zx8 .mission .link{ color:#58a6ff; }
  .zx8 .app-note{ border:.1rem solid rgba(var(--color-foreground),.25);
    border-left:.4rem solid #58a6ff; border-radius:.8rem;
    padding:1.2rem 1.6rem; max-width:76rem; margin:0; font-size:1.5rem; }
  .zx8 .app-h{ font-size:calc(var(--font-heading-scale) * 2rem);
    font-weight:700; margin:3.6rem 0 0; }
  .zx8 .app-h + .ways, .zx8 .app-h + .strip{ margin-top:1.4rem; }
  .zx8 .app-steps{ grid-template-columns:repeat(auto-fit,minmax(20rem,1fr)); }
  .zx8 .app-feats{ grid-template-columns:repeat(auto-fit,minmax(28rem,1fr)); }
  .zx8 .app-duo{ grid-template-columns:repeat(auto-fit,minmax(min(100%,36rem),1fr)); }
  /* card titles are h4 here (under the h3 sub-headings), sized like the
     page's h3 card titles */
  .zx8 .app h4{ margin:0 0 .6rem; font-size:calc(var(--font-heading-scale) * 1.7rem); }
  @media screen and (min-width: 750px){
    .zx8 .app h4{ font-size:calc(var(--font-heading-scale) * 1.8rem); }
  }
  .zx8 .app-text{ max-width:76rem; font-size:1.6rem; margin:1.4rem 0 0; }
  .zx8 .app-text p{ margin:0 0 1.2rem; opacity:.85; }
  .zx8 .app-h + details{ margin-top:1.4rem; }
</style>

<div class="zx8" style="padding-bottom:5.6rem;">

