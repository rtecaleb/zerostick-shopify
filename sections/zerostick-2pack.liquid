{% comment %}
  ZeroStick Pro TMR — DualSense Edge 2-Pack manufacturer product pages.

  ONE section drives THREE pages, switched on the page handle:

    /pages/tmr-2-pack          -> index: the official MSRP price list
    /pages/tmr-2-pack-black    -> 2 Pack Black product page
    /pages/tmr-2-pack-red      -> 2 Pack Red product page

  Every price, SKU, image and buy link is a theme setting, so the numbers live
  in one place and are edited in the customizer. Styles are scoped under .zs2p.
{% endcomment %}

{%- liquid
  assign h = page.handle | default: '' | downcase
  assign face = 'index'
  if h contains 'black'
    assign face = 'black'
  elsif h contains 'red'
    assign face = 'red'
  endif
-%}

<style>
  .zs2p{ line-height:1.6; }
  .zs2p .inner{ max-width:112rem; margin:0 auto; padding:0 2rem; }
  .zs2p .eyebrow{ font-size:1.2rem; font-weight:700; letter-spacing:.14em;
    text-transform:uppercase; opacity:.7; margin:0 0 1rem; }
  .zs2p .brandbar{ display:flex; align-items:center; gap:1.4rem; flex-wrap:wrap;
    padding:2.8rem 0 0; }
  .zs2p .brandbar img{ height:3.6rem; width:auto; display:block; }
  .zs2p .brandbar .who{ font-size:1.25rem; opacity:.7; }

  .zs2p .pack-badge{ display:inline-flex; align-items:baseline; gap:.6rem;
    background:#1668dc; color:#fff; border-radius:.8rem; padding:.7rem 1.4rem;
    font-weight:800; letter-spacing:.06em; line-height:1; }
  .zs2p .pack-badge .n{ font-size:2.6rem; }
  .zs2p .pack-badge .w{ font-size:1.5rem; text-transform:uppercase; }

  .zs2p h1{ font-size:3rem; line-height:1.25; margin:1.6rem 0 .8rem; }
  .zs2p h2{ margin:4.2rem 0 1.2rem; }
  .zs2p h3{ margin:0 0 .6rem; font-size:1.7rem; }
  .zs2p .sub{ font-size:1.5rem; opacity:.8; margin:0 0 1.6rem; max-width:72rem; }

  .zs2p .layout{ display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);
    gap:3.2rem; align-items:start; margin:2.4rem 0 0; }
  @media (max-width:989px){ .zs2p .layout{ grid-template-columns:1fr; gap:2.4rem; } }

  .zs2p .packshot{ border:.1rem solid rgba(var(--color-foreground),.16);
    border-radius:1.4rem; padding:1.6rem; background:rgba(var(--color-foreground),.03); }
  .zs2p .packshot .duo{ display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .zs2p .packshot .duo img{ width:100%; height:auto; display:block; border-radius:.8rem; }
  .zs2p .packshot figcaption{ font-size:1.2rem; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; opacity:.68; margin:1.2rem 0 0; text-align:center; }
  .zs2p .thumbs{ display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin:1.2rem 0 0; }
  .zs2p .thumbs img{ width:100%; height:auto; display:block; border-radius:.8rem;
    border:.1rem solid rgba(var(--color-foreground),.14); }

  .zs2p .pricebox{ border:.1rem solid rgba(var(--color-foreground),.18);
    border-radius:1.4rem; padding:2.2rem 2.4rem; }
  .zs2p .msrp-label{ font-size:1.25rem; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; opacity:.75; margin:0 0 .4rem; }
  .zs2p .msrp-value{ font-size:3.4rem; font-weight:800; line-height:1; margin:0; }
  .zs2p .msrp-note{ font-size:1.3rem; opacity:.7; margin:.8rem 0 0; }
  .zs2p .selling{ margin:1.8rem 0 0; padding:1.4rem 0 0;
    border-top:.1rem solid rgba(var(--color-foreground),.14); font-size:1.45rem; }
  .zs2p .selling strong{ font-size:1.8rem; }
  .zs2p .buyrow{ display:flex; flex-wrap:wrap; gap:1rem; margin:1.8rem 0 0; }
  .zs2p .btn-buy{ display:inline-block; background:#1668dc; color:#fff;
    border-radius:.8rem; padding:1.2rem 2.4rem; font-weight:700; font-size:1.5rem;
    text-decoration:none; }
  /* `inherit`, not --color-foreground: inside the price box that token resolves
     dark on the navy scheme and the link all but disappears. */
  .zs2p .btn-buy.ghost{ background:transparent; color:inherit;
    border:.1rem solid currentColor; opacity:.75; }
  .zs2p .btn-buy.ghost:hover{ opacity:1; }
  .zs2p .btn-buy:hover{ opacity:.9; }

  .zs2p .idgrid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));
    gap:1rem; margin:1.8rem 0 0; padding:1.4rem 0 0;
    border-top:.1rem solid rgba(var(--color-foreground),.14); }
  .zs2p .idgrid div span{ display:block; font-size:1.1rem; font-weight:700;
    letter-spacing:.1em; text-transform:uppercase; opacity:.62; margin:0 0 .3rem; }
  .zs2p .idgrid div b{ font-size:1.4rem; font-weight:600; }

  .zs2p .bullets{ margin:1.8rem 0 0; padding:0; list-style:none; }
  .zs2p .bullets li{ position:relative; padding:0 0 0 2.2rem; margin:0 0 1rem;
    font-size:1.45rem; opacity:.88; }
  .zs2p .bullets li::before{ content:''; position:absolute; left:0; top:.7rem;
    width:.8rem; height:.8rem; border-radius:50%; background:#1668dc; }

  .zs2p table.specs{ width:100%; border-collapse:collapse; margin:1.4rem 0 0; font-size:1.42rem; }
  .zs2p table.specs th, .zs2p table.specs td{ text-align:left; padding:1rem 1.2rem;
    border-bottom:.1rem solid rgba(var(--color-foreground),.12); vertical-align:top; }
  .zs2p table.specs th{ width:34%; font-weight:700; opacity:.78; }
  @media (max-width:600px){ .zs2p table.specs th{ width:44%; } }

  .zs2p .wrap{ overflow-x:auto; }
  .zs2p .pricetable{ width:100%; border-collapse:collapse; margin:1.8rem 0 0; font-size:1.45rem; }
  /* Only the short columns hold their line; the product name wraps, otherwise
     the table overflows and the product-page link is scrolled off. */
  .zs2p .pricetable th, .zs2p .pricetable td{ text-align:left; padding:1.2rem 1.2rem;
    border-bottom:.1rem solid rgba(var(--color-foreground),.14); }
  .zs2p .pricetable td.money, .zs2p .pricetable td.sku,
  .zs2p .pricetable td.cfg, .zs2p .pricetable td.go{ white-space:nowrap; }
  .zs2p .pricetable thead th{ font-size:1.15rem; letter-spacing:.1em;
    text-transform:uppercase; opacity:.68; }
  .zs2p .pricetable td.money{ font-weight:800; }
  .zs2p .pricetable a{ color:#58a6ff; }

  .zs2p .cards{ display:grid; grid-template-columns:repeat(auto-fit,minmax(26rem,1fr));
    gap:1.4rem; margin:2.4rem 0 0; }
  .zs2p .card{ border:.1rem solid rgba(var(--color-foreground),.16);
    border-radius:1.2rem; padding:1.8rem 2rem; display:flex; flex-direction:column; }
  .zs2p .card img{ width:100%; height:auto; border-radius:.8rem; margin:0 0 1.4rem; }
  .zs2p .card .price{ font-size:2.2rem; font-weight:800; margin:.4rem 0 0; }
  .zs2p .card .lbl{ font-size:1.15rem; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; opacity:.68; }
  .zs2p .card .btn-buy{ margin-top:1.6rem; align-self:flex-start; }

  .zs2p details{ border:.1rem solid rgba(var(--color-foreground),.14);
    border-radius:1rem; padding:1.2rem 1.6rem; margin:0 0 1rem; }
  .zs2p summary{ font-weight:600; cursor:pointer; font-size:1.5rem; }
  .zs2p details p{ margin:.8rem 0 0; opacity:.8; font-size:1.45rem; }

  .zs2p .fine{ font-size:1.28rem; opacity:.68; margin:4rem 0 0;
    border-top:.1rem solid rgba(var(--color-foreground),.12); padding-top:1.6rem; }
  .zs2p .fine p{ margin:0 0 .8rem; }
</style>

<div class="zs2p" style="padding-bottom:5.6rem;">
  <div class="inner">

    <div class="brandbar">
      <img src="{{ 'zerostick-logo.png' | asset_url }}" alt="ZeroStick" />
      <span class="who">Official manufacturer product information &middot; ZeroStick&reg;</span>
    </div>

    {%- comment -%} ============== INDEX: the official MSRP price list ============== {%- endcomment -%}
    {%- if face == 'index' -%}

      <p class="eyebrow" style="margin-top:2.8rem;">Manufacturer&rsquo;s Suggested Retail Price</p>
      <h1>{{ section.settings.index_heading }}</h1>
      <p class="sub">{{ section.settings.index_intro }}</p>

      <div class="wrap">
        <table class="pricetable">
          <thead>
            <tr>
              <th>Product</th>
              <th>Configuration</th>
              <th>Model / SKU</th>
              <th>MSRP (USD)</th>
              <th>Product page</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{{ section.settings.family_name }}</td>
              <td class="cfg">2 Pack &mdash; Black</td>
              <td class="sku">{{ section.settings.sku_black }}</td>
              <td class="money">{{ section.settings.msrp_black }}</td>
              <td class="go"><a href="{{ section.settings.page_black }}">View product</a></td>
            </tr>
            <tr>
              <td>{{ section.settings.family_name }}</td>
              <td class="cfg">2 Pack &mdash; Red</td>
              <td class="sku">{{ section.settings.sku_red }}</td>
              <td class="money">{{ section.settings.msrp_red }}</td>
              <td class="go"><a href="{{ section.settings.page_red }}">View product</a></td>
            </tr>
            {%- if section.settings.show_single_row -%}
              <tr>
                <td>{{ section.settings.family_name }}</td>
                <td class="cfg">Single Module &mdash; {{ section.settings.single_colors }}</td>
                <td class="sku">{{ section.settings.sku_single }}</td>
                <td class="money">{{ section.settings.msrp_single }}</td>
                <td class="go"><a href="{{ section.settings.page_single }}">View product</a></td>
              </tr>
            {%- endif -%}
          </tbody>
        </table>
      </div>

      <div class="cards">
        <div class="card">
          {%- if section.settings.img_black != blank -%}
            <img src="{{ section.settings.img_black }}" loading="lazy"
                 alt="ZeroStick Pro TMR joystick module for PS5 DualSense Edge, black, 2 pack" />
          {%- endif -%}
          <span class="lbl">2 Pack &mdash; Black</span>
          <h3>{{ section.settings.family_name }}</h3>
          <span class="lbl" style="margin-top:1rem;">Manufacturer&rsquo;s Suggested Retail Price</span>
          <div class="price">{{ section.settings.msrp_black }}</div>
          <a class="btn-buy" href="{{ section.settings.page_black }}">View product &amp; buy</a>
        </div>
        <div class="card">
          {%- if section.settings.img_red != blank -%}
            <img src="{{ section.settings.img_red }}" loading="lazy"
                 alt="ZeroStick Pro TMR joystick module for PS5 DualSense Edge, red, 2 pack" />
          {%- endif -%}
          <span class="lbl">2 Pack &mdash; Red</span>
          <h3>{{ section.settings.family_name }}</h3>
          <span class="lbl" style="margin-top:1rem;">Manufacturer&rsquo;s Suggested Retail Price</span>
          <div class="price">{{ section.settings.msrp_red }}</div>
          <a class="btn-buy" href="{{ section.settings.page_red }}">View product &amp; buy</a>
        </div>
      </div>

      <div class="fine">
        <p>{{ section.settings.fine_print }}</p>
      </div>

    {%- else -%}

      {%- comment -%} ============== PRODUCT FACE: black or red ============== {%- endcomment -%}
      {%- liquid
        if face == 'black'
          assign colour     = 'Black'
          assign full_name  = section.settings.name_black
          assign msrp       = section.settings.msrp_black
          assign price      = section.settings.price_black
          assign sku        = section.settings.sku_black
          assign buy        = section.settings.buy_black
          assign img_main   = section.settings.img_black
          assign other_url  = section.settings.page_red
          assign other_name = 'the 2 Pack Red'
        else
          assign colour     = 'Red'
          assign full_name  = section.settings.name_red
          assign msrp       = section.settings.msrp_red
          assign price      = section.settings.price_red
          assign sku        = section.settings.sku_red
          assign buy        = section.settings.buy_red
          assign img_main   = section.settings.img_red
          assign other_url  = section.settings.page_black
          assign other_name = 'the 2 Pack Black'
        endif
      -%}

      <div style="margin-top:2.6rem;">
        <span class="pack-badge"><span class="n">2</span><span class="w">Pack</span></span>
      </div>

      <h1>{{ full_name }}</h1>
      <p class="sub">
        Colour: <strong>{{ colour }}</strong> &middot; Platform: PlayStation&nbsp;5 &middot;
        Fits the PS5 DualSense&nbsp;Edge wireless controller. Sold as a boxed two-module retail pack.
      </p>

      <div class="layout">
        <div>
          <figure class="packshot" style="margin:0;">
            <div class="duo">
              {%- if img_main != blank -%}
                <img src="{{ img_main }}"
                     alt="ZeroStick Pro TMR joystick module, {{ colour | downcase }} &mdash; module 1 of 2" />
                <img src="{{ img_main }}" loading="lazy"
                     alt="ZeroStick Pro TMR joystick module, {{ colour | downcase }} &mdash; module 2 of 2" />
              {%- endif -%}
            </div>
            <figcaption>What&rsquo;s in the box &mdash; 2 &times; TMR module ({{ colour }})</figcaption>
          </figure>

          <div class="thumbs">
            {%- if section.settings.img_detail_1 != blank -%}
              <img src="{{ section.settings.img_detail_1 }}" loading="lazy"
                   alt="K-Silver TMR magnetic sensor detail" />
            {%- endif -%}
            {%- if section.settings.img_detail_2 != blank -%}
              <img src="{{ section.settings.img_detail_2 }}" loading="lazy"
                   alt="ZeroStick Pro module installed in a PS5 DualSense Edge controller" />
            {%- endif -%}
            {%- if section.settings.img_detail_3 != blank -%}
              <img src="{{ section.settings.img_detail_3 }}" loading="lazy"
                   alt="ZeroStick Pro TMR module specification overview" />
            {%- endif -%}
          </div>
        </div>

        <div>
          <div class="pricebox">
            <p class="msrp-label">Manufacturer&rsquo;s Suggested Retail Price (MSRP)</p>
            <p class="msrp-value">{{ msrp }}</p>
            <p class="msrp-note">{{ section.settings.msrp_note }}</p>

            <div class="selling">
              Current price on zerostickgaming.com: <strong>{{ price }}</strong> USD
            </div>

            <div class="buyrow">
              {%- if buy != blank -%}
                <a class="btn-buy" href="{{ buy }}">Add to cart &mdash; {{ price }}</a>
              {%- endif -%}
              <a class="btn-buy ghost" href="{{ other_url }}">See {{ other_name }}</a>
            </div>

            <div class="idgrid">
              <div><span>Brand</span><b>ZeroStick</b></div>
              <div><span>Model / SKU</span><b>{{ sku }}</b></div>
              <div><span>Pack size</span><b>2 modules</b></div>
              <div><span>Colour</span><b>{{ colour }}</b></div>
            </div>
          </div>

          <h2 style="margin-top:3.4rem;">About this product</h2>
          <p class="sub" style="margin-bottom:0;">{{ section.settings.blurb }}</p>

          <ul class="bullets">
            <li><strong>True drift-free performance.</strong> TMR (Tunneling Magnetoresistance) magnetic sensors remove the mechanical wiper contact that causes stick drift &mdash; there is nothing in the sensing path to wear out.</li>
            <li><strong>Extended lifespan.</strong> Magnetic sensing means no carbon contacts to degrade. Rated for 50 million+ cycles, and 5&ndash;10&times; the life of a traditional potentiometer stick.</li>
            <li><strong>Zero added latency.</strong> Reports identically to the stock module &mdash; no software layer, no polling penalty.</li>
            <li><strong>Plug and play.</strong> A direct drop-in replacement for the DualSense Edge stick module. No soldering required.</li>
            <li><strong>Calibrated out of the box, and stays unlocked.</strong> Every module is calibrated and tested before it ships, and standard recalibration remains available at any time.</li>
            <li><strong>{{ section.settings.warranty_line }}</strong></li>
          </ul>
        </div>
      </div>

      <h2>Specifications</h2>
      <table class="specs">
        <tbody>
          <tr><th>Product name</th><td>{{ full_name }}</td></tr>
          <tr><th>Brand</th><td>ZeroStick</td></tr>
          <tr><th>Model / SKU</th><td>{{ sku }}</td></tr>
          <tr><th>Configuration</th><td>2 Pack &mdash; two (2) joystick modules per box</td></tr>
          <tr><th>Colour</th><td>{{ colour }}</td></tr>
          <tr><th>Sensor type</th><td>K-Silver TMR (Tunneling Magnetoresistance) &mdash; contactless magnetic</td></tr>
          <tr><th>Rated lifespan</th><td>50,000,000+ cycles</td></tr>
          <tr><th>Added latency</th><td>None &mdash; 0&nbsp;ms versus the stock module</td></tr>
          <tr><th>Compatibility</th><td>Sony PlayStation&nbsp;5 DualSense&nbsp;Edge wireless controller</td></tr>
          <tr><th>Installation</th><td>Drop-in replacement, no soldering</td></tr>
          <tr><th>Calibration</th><td>Pre-calibrated and tested; calibration remains user-unlocked</td></tr>
          <tr><th>Assembly</th><td>{{ section.settings.assembly_line }}</td></tr>
          <tr><th>Warranty</th><td>{{ section.settings.warranty_line }}</td></tr>
          <tr><th>MSRP</th><td>{{ msrp }} USD (Manufacturer&rsquo;s Suggested Retail Price)</td></tr>
        </tbody>
      </table>

      <h2>Questions</h2>
      <details>
        <summary>Will these fit a standard DualSense, or only the Edge?</summary>
        <p>These are the DualSense&nbsp;Edge modules. The Edge uses a removable stick module with its own connector, which is what this pack replaces. A standard DualSense uses a different, soldered stick and needs a different part.</p>
      </details>
      <details>
        <summary>Why does my game still show a small deadzone?</summary>
        <p>Because of how Hall-effect and TMR sensors work, most games apply a small 2&ndash;3% in-game deadzone. That is normal and within specification.</p>
      </details>
      <details>
        <summary>Why buy the 2 Pack?</summary>
        <p>A DualSense Edge has two stick modules. The 2 Pack is the boxed retail configuration that replaces both at once, so the pair is matched and calibrated together.</p>
      </details>

      <div class="fine">
        <p>{{ section.settings.fine_print }}</p>
      </div>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "ZS TMR 2-Pack",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Shared" },
    {
      "type": "text",
      "id": "family_name",
      "label": "Product family name",
      "default": "ZeroStick Pro Custom TMR Hall Effect Joystick Module — PS5 DualSense Edge"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Short description",
      "default": "A boxed pair of ZeroStick Pro replacement joystick modules for the PS5 DualSense Edge, built around K-Silver TMR magnetic sensors. Magnetic, contactless sensing means there is no carbon wiper to wear down, so stick drift never develops. Both modules are calibrated and tested before they leave us."
    },
    {
      "type": "text",
      "id": "warranty_line",
      "label": "Warranty line",
      "info": "Keep this in step with the site announcement bar and the single-module product page.",
      "default": "5-year stick warranty."
    },
    {
      "type": "text",
      "id": "assembly_line",
      "label": "Assembly line",
      "default": "Modified, calibrated and assembled in California, USA"
    },
    {
      "type": "textarea",
      "id": "msrp_note",
      "label": "MSRP note (under the MSRP figure)",
      "default": "MSRP is set by ZeroStick as the manufacturer of this product and applies to this boxed 2-pack configuration."
    },
    {
      "type": "textarea",
      "id": "fine_print",
      "label": "Fine print",
      "default": "ZeroStick® is the manufacturer and brand owner of the products on this page; zerostickgaming.com is the official ZeroStick brand site. Prices are in US dollars and exclude tax and shipping. MSRP applies to the configuration shown and is current as of the date of publication. PlayStation, PS5 and DualSense Edge are trademarks of Sony Interactive Entertainment Inc. ZeroStick is not affiliated with or endorsed by Sony Interactive Entertainment Inc."
    },

    { "type": "header", "content": "2 Pack — Black" },
    {
      "type": "text",
      "id": "name_black",
      "label": "Full product name",
      "default": "ZeroStick Pro Custom TMR Hall Effect Joystick Module — Compatible with PS5 DualSense Edge — TMR Drift Free Magnetic Stick Replacement, High Precision Long Life Design (2 Pack Black)"
    },
    { "type": "text", "id": "msrp_black", "label": "MSRP", "default": "$139.99" },
    { "type": "text", "id": "price_black", "label": "Current selling price", "default": "$139.99" },
    { "type": "text", "id": "sku_black", "label": "Model / SKU", "default": "ZS-PRO-DSE-2PK-BLK" },
    {
      "type": "text",
      "id": "img_black",
      "label": "Product image URL",
      "default": "https://cdn.shopify.com/s/files/1/0782/4624/8633/files/MAIN_BLACK_STICK.png?v=1779484666"
    },
    {
      "type": "text",
      "id": "buy_black",
      "label": "Add-to-cart / product link",
      "default": "/products/zerostick-pro-tmr-dualsense-edge-module-2-pack-black"
    },
    {
      "type": "text",
      "id": "page_black",
      "label": "Page URL (cross-links)",
      "default": "/pages/tmr-2-pack-black"
    },

    { "type": "header", "content": "2 Pack — Red" },
    {
      "type": "text",
      "id": "name_red",
      "label": "Full product name",
      "default": "ZeroStick Pro Custom TMR Hall Effect Joystick Module — Compatible with PS5 DualSense Edge — TMR Drift Free Magnetic Stick Replacement, High Precision Long Life Design (2 Pack Red)"
    },
    { "type": "text", "id": "msrp_red", "label": "MSRP", "default": "$149.99" },
    { "type": "text", "id": "price_red", "label": "Current selling price", "default": "$149.99" },
    { "type": "text", "id": "sku_red", "label": "Model / SKU", "default": "ZS-PRO-DSE-2PK-RED" },
    {
      "type": "text",
      "id": "img_red",
      "label": "Product image URL",
      "default": "https://cdn.shopify.com/s/files/1/0782/4624/8633/files/MAIN_RED_STICK.png?v=1779484666"
    },
    {
      "type": "text",
      "id": "buy_red",
      "label": "Add-to-cart / product link",
      "default": "/products/zerostick-pro-tmr-dualsense-edge-module-2-pack-red"
    },
    {
      "type": "text",
      "id": "page_red",
      "label": "Page URL (cross-links)",
      "default": "/pages/tmr-2-pack-red"
    },

    { "type": "header", "content": "Detail images (product pages)" },
    {
      "type": "text",
      "id": "img_detail_1",
      "label": "Detail image 1 URL",
      "default": "https://cdn.shopify.com/s/files/1/0782/4624/8633/files/image_2.webp?v=1783121683"
    },
    {
      "type": "text",
      "id": "img_detail_2",
      "label": "Detail image 2 URL",
