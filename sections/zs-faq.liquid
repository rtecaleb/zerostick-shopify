{% comment %}
  ZeroStick FAQ — visible accordion + FAQPage structured data.

  Why this section exists: FAQPage is the single most extractable format for
  AI search. A question/answer pair is already the shape an assistant wants to
  quote, so this is the cheapest way to become the cited source for a query.

  Two rules this section is built around:
    1. Answers render in the DOM (via <details>, not JS) so crawlers and
       assistants read them without executing anything. Google requires the
       schema to match visible content — hiding answers behind script would
       make the markup ineligible and is a manual-action risk.
    2. Answers are plain prose with concrete numbers in them. "Fast shipping"
       is unquotable; "ships in 1-2 business days, free over $100" is the
       sentence that ends up in an answer.

  Self-contained: styles scoped under .zs-faq, colours from theme tokens.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .zs-faq{ line-height:1.6; }
  .zs-faq .zs-faq-head{ margin:0 0 2.4rem; }
  .zs-faq h2{ margin:0 0 .8rem; }
  .zs-faq .zs-faq-lede{ font-size:1.6rem; opacity:.75; margin:0; }
  .zs-faq details{ border:.1rem solid rgba(var(--color-foreground),.14);
    border-radius:1rem; padding:0; margin:0 0 1rem; overflow:hidden; }
  .zs-faq details[open]{ border-color:rgba(var(--color-foreground),.28); }
  .zs-faq summary{ display:flex; align-items:center; justify-content:space-between;
    gap:1.6rem; padding:1.6rem 2rem; cursor:pointer; list-style:none;
    font-size:1.6rem; font-weight:600; }
  .zs-faq summary::-webkit-details-marker{ display:none; }
  .zs-faq summary::after{ content:''; flex:none; width:.9rem; height:.9rem;
    border-right:.2rem solid currentColor; border-bottom:.2rem solid currentColor;
    transform:rotate(45deg); transition:transform .2s ease; opacity:.55; }
  .zs-faq details[open] summary::after{ transform:rotate(-135deg); }
  .zs-faq .zs-faq-a{ padding:0 2rem 1.8rem; font-size:1.5rem; opacity:.82; }
  .zs-faq .zs-faq-a > :first-child{ margin-top:0; }
  .zs-faq .zs-faq-a > :last-child{ margin-bottom:0; }
  @media (max-width:749px){
    .zs-faq summary{ padding:1.4rem 1.6rem; font-size:1.5rem; }
    .zs-faq .zs-faq-a{ padding:0 1.6rem 1.6rem; }
  }
</style>

<div class="zs-faq page-width section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank or section.settings.lede != blank -%}
    <div class="zs-faq-head">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="zs-faq-lede">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.settings.question != blank and block.settings.answer != blank -%}
      <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
        <summary>{{ block.settings.question | escape }}</summary>
        <div class="zs-faq-a">{{ block.settings.answer }}</div>
      </details>
    {%- endif -%}
  {%- endfor -%}
</div>

{%- comment -%}
  Emit FAQPage only when there is at least one complete pair — an empty
  mainEntity array is invalid markup and will throw in Search Console.
{%- endcomment -%}
{%- assign faq_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.settings.question != blank and block.settings.answer != blank -%}
    {%- assign faq_count = faq_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if faq_count > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign i = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- assign i = i | plus: 1 -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
          }
        }{% unless i == faq_count %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "ZeroStick FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "info": "Write it the way a buyer would type it into Google or ChatGPT."
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "info": "Lead with the direct answer, then the detail. Use real numbers — days, years, dollars, model names."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZeroStick FAQ",
      "blocks": [
        { "type": "qa" },
        { "type": "qa" },
        { "type": "qa" }
      ]
    }
  ]
}
{% endschema %}
